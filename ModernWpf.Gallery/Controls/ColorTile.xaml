<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ModernWpf.Gallery.Controls">

    <Style TargetType="{x:Type controls:ColorTile}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="MinHeight" Value="124" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="TileRadius" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ColorTile}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderThickness="0"
                        CornerRadius="{TemplateBinding TileRadius}"
                        Style="{DynamicResource ColorTilesPanelStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="30" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    x:Name="ColorNameTextBlock"
                                    Margin="12,12,0,6"
                                    Foreground="{TemplateBinding Foreground}"
                                    Style="{DynamicResource BodyStrongTextBlockStyle}"
                                    Text="{TemplateBinding ColorName}"
                                    TextWrapping="Wrap" />

                                <Button
                                    x:Name="CopyBrushNameButton"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Grid.RowSpan="4"
                                    Margin="0,12,12,0"
                                    Padding="4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    AutomationProperties.Name="{Binding ColorBrushName, StringFormat='{}Copy brush name {0} to clipboard', RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Command="ApplicationCommands.Copy"
                                    CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type controls:ColorTile}}}"
                                    FocusManager.IsFocusScope="True"
                                    Foreground="{TemplateBinding Foreground}"
                                    ToolTipService.ToolTip="Copy brush name">
                                    <Grid>
                                        <TextBlock
                                            x:Name="CopyGlyphTextBlock"
                                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                                            FontSize="16"
                                            Text="&#xE8C8;" />
                                        <TextBlock
                                            x:Name="SuccessGlyphTextBlock"
                                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                                            FontSize="16"
                                            Opacity="0"
                                            Text="&#xE73E;" />
                                    </Grid>
                                    <Button.Triggers>
                                        <EventTrigger RoutedEvent="Button.Click">
                                            <EventTrigger.Actions>
                                                <BeginStoryboard>
                                                    <Storyboard BeginTime="00:00:00">
                                                        <DoubleAnimation
                                                            Duration="0:0:0.333"
                                                            Storyboard.TargetName="CopyGlyphTextBlock"
                                                            Storyboard.TargetProperty="Opacity"
                                                            To="0" />
                                                        <DoubleAnimation
                                                            BeginTime="0:0:0.333"
                                                            Duration="0:0:0.666"
                                                            Storyboard.TargetName="SuccessGlyphTextBlock"
                                                            Storyboard.TargetProperty="Opacity"
                                                            To="1" />
                                                        <DoubleAnimation
                                                            BeginTime="0:0:2"
                                                            Duration="0:0:0.01"
                                                            Storyboard.TargetName="SuccessGlyphTextBlock"
                                                            Storyboard.TargetProperty="Opacity"
                                                            To="0" />
                                                        <DoubleAnimation
                                                            BeginTime="0:0:2.1"
                                                            Duration="0:0:0.01"
                                                            Storyboard.TargetName="CopyGlyphTextBlock"
                                                            Storyboard.TargetProperty="Opacity"
                                                            To="1" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger.Actions>
                                        </EventTrigger>
                                    </Button.Triggers>
                                </Button>

                                <TextBlock
                                    x:Name="ColorExplanationTextBlock"
                                    Grid.Row="1"
                                    Margin="12,-4,0,0"
                                    Style="{DynamicResource CaptionTextBlockStyle}"
                                    Text="{TemplateBinding ColorExplanation}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    x:Name="ColorBrushNameTextBlock"
                                    Grid.Row="3"
                                    Grid.ColumnSpan="2"
                                    Margin="12,0,0,18"
                                    Style="{DynamicResource CaptionTextBlockStyle}"
                                    Text="{TemplateBinding ColorBrushName}"
                                    TextWrapping="Wrap" />

                                <Grid
                                    Grid.Row="3"
                                    Grid.Column="2"
                                    Margin="0,0,12,0"
                                    Background="Transparent"
                                    ToolTipService.ToolTip="This brush might not (yet) be available in WPF."
                                    Visibility="{Binding ShowWarning, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource TemplatedParent}}">
                                    <TextBlock
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="16"
                                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                        Text="&#xE7BA;" />
                                </Grid>
                            </Grid>

                            <Border
                                Grid.Column="1"
                                Width="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Stretch"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{Binding ShowSeparator, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                            <Setter TargetName="ColorExplanationTextBlock" Property="Foreground" Value="{DynamicResource SystemColorWindowTextColorBrush}" />
                            <Setter TargetName="ColorExplanationTextBlock" Property="Background" Value="{DynamicResource SystemColorWindowColorBrush}" />
                            <Setter TargetName="ColorBrushNameTextBlock" Property="Foreground" Value="{DynamicResource SystemColorWindowTextColorBrush}" />
                            <Setter TargetName="ColorBrushNameTextBlock" Property="Background" Value="{DynamicResource SystemColorWindowColorBrush}" />
                            <Setter TargetName="ColorNameTextBlock" Property="Foreground" Value="{DynamicResource SystemColorWindowTextColorBrush}" />
                            <Setter TargetName="ColorNameTextBlock" Property="Background" Value="{DynamicResource SystemColorWindowColorBrush}" />
                            <Setter TargetName="CopyBrushNameButton" Property="Foreground" Value="{DynamicResource SystemColorWindowTextColorBrush}" />
                            <Setter TargetName="CopyBrushNameButton" Property="Background" Value="{DynamicResource SystemColorWindowColorBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
