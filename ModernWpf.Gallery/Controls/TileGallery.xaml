<UserControl
    x:Class="ModernWpf.Gallery.Controls.TileGallery"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ModernWpf.Gallery.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="220"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="TileGalleryScrollButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Border.CornerRadius" Value="4" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <ScrollViewer
            x:Name="RootScrollViewer"
            HorizontalScrollBarVisibility="Hidden"
            SizeChanged="RootScrollViewer_SizeChanged"
            VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="TilesPanel" Orientation="Horizontal">
                <local:HeaderTile
                    Margin="24,0,6,0"
                    Description="An overview of app development options, tools, and samples."
                    Link="https://learn.microsoft.com/windows/apps/get-started/"
                    Title="Getting started">
                    <local:HeaderTile.Source>
                        <Image Source="pack://application:,,,/ModernWpf.Gallery;component/Assets/AppIcons/WPFGallery_48px.png" />
                    </local:HeaderTile.Source>
                </local:HeaderTile>
                <local:HeaderTile
                    Description="Design guidelines and toolkits for creating native app experiences."
                    Link="https://learn.microsoft.com/windows/apps/design/"
                    Title="Windows design">
                    <local:HeaderTile.Source>
                        <Image Source="pack://application:,,,/ModernWpf.Gallery;component/Assets/HomeHeaderTiles/Header-WindowsDesign.png" />
                    </local:HeaderTile.Source>
                </local:HeaderTile>
                <local:HeaderTile
                    Description="A robust UI framework for your desktop applications."
                    Link="https://github.com/dotnet/wpf"
                    Title="WPF GitHub">
                    <local:HeaderTile.Source>
                        <Viewbox Height="52" Margin="-20,0,0,0">
                            <Path
                                Data="{StaticResource GitHubIconGeometry}"
                                Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Viewbox>
                    </local:HeaderTile.Source>
                </local:HeaderTile>
                <local:HeaderTile
                    Description="Find WPF samples that demonstrate specific tasks, features, and APIs."
                    Link="https://github.com/microsoft/WPF-Samples"
                    Title="Code samples">
                    <local:HeaderTile.Source>
                        <Viewbox Height="52" Margin="-20,0,0,0">
                            <Path
                                Data="{StaticResource GitHubIconGeometry}"
                                Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Viewbox>
                    </local:HeaderTile.Source>
                </local:HeaderTile>
                <local:HeaderTile
                    Description="Upload your app to the Store."
                    Link="https://developer.microsoft.com/windows/"
                    Title="Partner Center">
                    <local:HeaderTile.Source>
                        <Image Source="pack://application:,,,/ModernWpf.Gallery;component/Assets/HomeHeaderTiles/Header-Store.dark.png" />
                    </local:HeaderTile.Source>
                </local:HeaderTile>
            </StackPanel>
        </ScrollViewer>
        <Button
            x:Name="ScrollBackButton"
            Margin="8,-16,0,0"
            AutomationProperties.Name="Scroll left"
            Click="ScrollBackButton_Click"
            Style="{DynamicResource TileGalleryScrollButtonStyle}"
            ToolTip="Scroll left">
            <TextBlock
                FontFamily="{StaticResource SymbolThemeFontFamily}"
                FontSize="8"
                Text="&#xEDD9;" />
        </Button>
        <Button
            x:Name="ScrollForwardButton"
            Margin="0,-16,8,0"
            HorizontalAlignment="Right"
            AutomationProperties.Name="Scroll right"
            Click="ScrollForwardButton_Click"
            Style="{DynamicResource TileGalleryScrollButtonStyle}"
            ToolTip="Scroll right">
            <TextBlock
                FontFamily="{StaticResource SymbolThemeFontFamily}"
                FontSize="8"
                Text="&#xEDDA;" />
        </Button>
    </Grid>
</UserControl>
