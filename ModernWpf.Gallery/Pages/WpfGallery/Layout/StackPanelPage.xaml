<UserControl
    x:Class="ModernWpf.Gallery.Pages.WpfGallery.Layout.StackPanelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ModernWpf.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="ContentPagePane" Height="Auto">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader
            Margin="0,0,0,32"
            ShowDescription="False"
            Title="{Binding ViewModel.PageTitle}" />

        <ScrollViewer
            Grid.Row="1"
            Margin="0,0,0,24"
            Padding="0,0,24,0">
            <StackPanel Margin="0,0,0,24">
                <controls:ControlExample
                    Margin="10"
                    HeaderText="A basic vertical StackPanel"
                    XamlCode="&lt;StackPanel Orientation=&quot;Vertical&quot;&gt;&#xA;    &lt;Rectangle Width=&quot;100&quot; Height=&quot;30&quot; Fill=&quot;CornflowerBlue&quot; /&gt;&#xA;    &lt;Rectangle Width=&quot;100&quot; Height=&quot;30&quot; Fill=&quot;LightCoral&quot; /&gt;&#xA;    &lt;Rectangle Width=&quot;100&quot; Height=&quot;30&quot; Fill=&quot;MediumSeaGreen&quot; /&gt;&#xA;&lt;/StackPanel&gt;">
                    <StackPanel Orientation="Vertical">
                        <Rectangle
                            Width="100"
                            Height="30"
                            Margin="5"
                            Fill="CornflowerBlue" />
                        <Rectangle
                            Width="100"
                            Height="30"
                            Margin="5"
                            Fill="LightCoral" />
                        <Rectangle
                            Width="100"
                            Height="30"
                            Margin="5"
                            Fill="MediumSeaGreen" />
                    </StackPanel>
                </controls:ControlExample>

                <controls:ControlExample
                    Margin="10"
                    HeaderText="A horizontal StackPanel"
                    XamlCode="&lt;StackPanel Orientation=&quot;Horizontal&quot;&gt;&#xA;    &lt;Rectangle Width=&quot;100&quot; Height=&quot;30&quot; Fill=&quot;CornflowerBlue&quot; /&gt;&#xA;    &lt;Rectangle Width=&quot;100&quot; Height=&quot;30&quot; Fill=&quot;LightCoral&quot; /&gt;&#xA;    &lt;Rectangle Width=&quot;100&quot; Height=&quot;30&quot; Fill=&quot;MediumSeaGreen&quot; /&gt;&#xA;&lt;/StackPanel&gt;">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle
                            Width="100"
                            Height="30"
                            Margin="5"
                            Fill="CornflowerBlue" />
                        <Rectangle
                            Width="100"
                            Height="30"
                            Margin="5"
                            Fill="LightCoral" />
                        <Rectangle
                            Width="100"
                            Height="30"
                            Margin="5"
                            Fill="MediumSeaGreen" />
                    </StackPanel>
                </controls:ControlExample>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
