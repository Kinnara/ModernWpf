<Page
    x:Class="ModernWpf.Gallery.Pages.WpfGallery.Layout.GridSplitterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ModernWpf.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    Title="GridSplitterPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <sys:String x:Key="SampleText">
            Lorem Ipsum is simply dummy text of the printing and typesetting industry.
            Lorem Ipsum has been the industry's standard dummy text ever since the 1500s.
        </sys:String>
        <sys:String x:Key="SampleText2">
            When an unknown printer took a galley of type and scrambled it to
            make a type specimen book.
        </sys:String>
    </Page.Resources>

    <Grid x:Name="ContentPagePane" Height="Auto">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Margin="0,0,0,32" Title="{Binding ViewModel.PageTitle}" ShowDescription="False" />

        <ScrollViewer Grid.Row="1" Margin="0,0,0,24" Padding="0,0,24,0">
            <StackPanel Margin="0,0,0,24">
                <controls:ControlExample
                    Margin="10"
                    HeaderText="A GridSplitter"
                    XamlCode="&lt;Grid Height=&quot;400&quot;&gt;&#10;    &lt;Grid.RowDefinitions&gt;&#10;        &lt;RowDefinition Height=&quot;Auto&quot; /&gt;&#10;        &lt;RowDefinition Height=&quot;*&quot; /&gt;&#10;    &lt;/Grid.RowDefinitions&gt;&#10;    &lt;TextBlock Style=&quot;{DynamicResource TitleTextBlockStyle}&quot; Text=&quot;Grid Splitter&quot; Margin=&quot;0 0 0 10&quot;/&gt;&#10;    &lt;Border BorderBrush=&quot;{DynamicResource ControlElevationBorderBrush}&quot; BorderThickness=&quot;2&quot; Grid.Row=&quot;1&quot; Padding=&quot;10&quot; CornerRadius=&quot;4&quot;&gt;&#10;        &lt;Grid Background=&quot;{DynamicResource ControlAltFillColorSecondaryBrush}&quot;&gt;&#10;            &lt;Grid.RowDefinitions&gt;&#10;                &lt;RowDefinition Height=&quot;*&quot; /&gt;&#10;                &lt;RowDefinition Height=&quot;Auto&quot; /&gt;&#10;                &lt;RowDefinition Height=&quot;*&quot; /&gt;&#10;                &lt;RowDefinition Height=&quot;Auto&quot; /&gt;&#10;                &lt;RowDefinition Height=&quot;*&quot; /&gt;&#10;                &lt;RowDefinition Height=&quot;Auto&quot; /&gt;&#10;                &lt;RowDefinition Height=&quot;*&quot; /&gt;&#10;            &lt;/Grid.RowDefinitions&gt;&#10;            &lt;Grid.ColumnDefinitions&gt;&#10;                &lt;ColumnDefinition Width=&quot;*&quot; /&gt;&#10;                &lt;ColumnDefinition Width=&quot;Auto&quot; /&gt;&#10;                &lt;ColumnDefinition Width=&quot;*&quot; /&gt;&#10;            &lt;/Grid.ColumnDefinitions&gt;&#10;            &lt;TextBlock TextWrapping=&quot;Wrap&quot; Text=&quot;{StaticResource SampleText}&quot; /&gt;&#10;            &lt;TextBlock Grid.Row=&quot;0&quot; Grid.Column=&quot;2&quot; TextWrapping=&quot;Wrap&quot; Text=&quot;{StaticResource SampleText2}&quot;/&gt;&#10;            &lt;TextBlock Grid.Row=&quot;2&quot; Grid.Column=&quot;2&quot; TextWrapping=&quot;Wrap&quot; Text=&quot;{StaticResource SampleText}&quot;/&gt;&#10;            &lt;TextBlock Grid.Row=&quot;2&quot; Grid.Column=&quot;0&quot; TextWrapping=&quot;Wrap&quot; Text=&quot;{StaticResource SampleText2}&quot;/&gt;&#10;            &lt;TextBlock Grid.Row=&quot;4&quot; Grid.Column=&quot;2&quot; TextWrapping=&quot;Wrap&quot; Text=&quot;{StaticResource SampleText2}&quot;/&gt;&#10;            &lt;TextBlock Grid.Row=&quot;4&quot; Grid.Column=&quot;0&quot; TextWrapping=&quot;Wrap&quot; Text=&quot;{StaticResource SampleText}&quot;/&gt;&#10;            &lt;GridSplitter Grid.RowSpan=&quot;5&quot; Grid.Column=&quot;1&quot; /&gt;&#10;            &lt;GridSplitter Grid.Row=&quot;1&quot; Grid.ColumnSpan=&quot;3&quot;/&gt;&#10;            &lt;GridSplitter Grid.Row=&quot;3&quot; Grid.ColumnSpan=&quot;1&quot;/&gt;&#10;        &lt;/Grid&gt;&#10;    &lt;/Border&gt;&#10;&lt;/Grid&gt;">
                    <Grid Height="400">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Margin="0 0 0 10"
                            Style="{DynamicResource TitleTextBlockStyle}"
                            Text="Grid Splitter" />
                        <Border
                            Grid.Row="1"
                            Padding="10"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="2"
                            CornerRadius="4">
                            <Grid Background="{DynamicResource ControlAltFillColorSecondaryBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{StaticResource SampleText}" TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Text="{StaticResource SampleText2}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    Text="{StaticResource SampleText}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Text="{StaticResource SampleText2}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="2"
                                    Text="{StaticResource SampleText2}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Text="{StaticResource SampleText}"
                                    TextWrapping="Wrap" />
                                <GridSplitter
                                    Grid.RowSpan="5"
                                    Grid.Column="1"
                                    ResizeDirection="Columns" />
                                <GridSplitter
                                    Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    ResizeDirection="Rows" />
                                <GridSplitter
                                    Grid.Row="3"
                                    Grid.ColumnSpan="1"
                                    ResizeDirection="Rows" />
                            </Grid>
                        </Border>
                    </Grid>
                </controls:ControlExample>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
