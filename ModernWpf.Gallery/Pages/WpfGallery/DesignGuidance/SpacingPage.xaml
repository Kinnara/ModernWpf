<UserControl
    x:Class="ModernWpf.Gallery.Pages.WpfGallery.DesignGuidance.SpacingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ModernWpf.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader
            Margin="0,0,0,32"
            Description="{Binding ViewModel.PageDescription}"
            Title="{Binding ViewModel.PageTitle}" />

        <ScrollViewer
            Grid.Row="1"
            Margin="0,0,0,24"
            Padding="0,0,24,0"
            HorizontalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,24" Orientation="Vertical">
                <TextBlock HorizontalAlignment="Left" Text="Consistent spacing helps create visual harmony and improves the readability and usability of your application." TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,12"
                    HorizontalAlignment="Left"
                    Text="Use the following spacing values to maintain a consistent layout throughout your app."
                    TextWrapping="Wrap" />

                <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                    <Grid VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Page with cards layout" />
                        <Border Grid.Row="1" Height="500">
                            <Image
                                x:Name="CardImage"
                                AutomationProperties.Name="Example of spacing in a page with cards layout" />
                        </Border>
                    </Grid>

                    <Grid VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Form layout" />
                        <Border Grid.Row="1" Height="500">
                            <Image
                                x:Name="DialogImage"
                                AutomationProperties.Name="Example of spacing in a form layout" />
                        </Border>
                    </Grid>
                </StackPanel>

                <Border
                    Margin="0,10,0,10"
                    Padding="16"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,1,0"
                    CornerRadius="8,8,0,0">
                    <Grid HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="400" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="16,0,0,24"
                            Opacity="0.7"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Value" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="16,0,0,24"
                            Opacity="0.7"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Usage" />

                        <Grid
                            Grid.Row="1"
                            Grid.ColumnSpan="3"
                            MinHeight="60"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="400" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" Text="4px" />
                            <Border Grid.Column="1" Width="4" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="4" />
                            <TextBlock Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="Spacing used for compact sizing." TextWrapping="Wrap" />
                        </Grid>
                        <Grid Grid.Row="2" Grid.ColumnSpan="3" MinHeight="60">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="400" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" Text="8px" />
                            <Border Grid.Column="1" Width="8" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="4" />
                            <TextBlock Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="Spacing between UI controls, control + label." TextWrapping="Wrap" />
                        </Grid>
                        <Grid
                            Grid.Row="3"
                            Grid.ColumnSpan="3"
                            MinHeight="60"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="400" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" Text="12px" />
                            <Border Grid.Column="1" Width="12" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="4" />
                            <TextBlock Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="Spacing between control + header, surface and edge text, text sections." TextWrapping="Wrap" />
                        </Grid>
                        <Grid Grid.Row="4" Grid.ColumnSpan="3" MinHeight="60">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="400" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" Text="16px" />
                            <Border Grid.Column="1" Width="16" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="4" />
                            <TextBlock Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="Padding used in list styles, cards." TextWrapping="Wrap" />
                        </Grid>
                        <Grid
                            Grid.Row="5"
                            Grid.ColumnSpan="3"
                            MinHeight="60"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="400" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" Text="24px" />
                            <Border Grid.Column="1" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="4" />
                            <TextBlock Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="Spacing between content sections." TextWrapping="Wrap" />
                        </Grid>
                        <Grid Grid.Row="6" Grid.ColumnSpan="3" MinHeight="60">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="400" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" Text="32px" />
                            <Border Grid.Column="1" Width="32" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="4" />
                            <TextBlock Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="Padding on pages." TextWrapping="Wrap" />
                        </Grid>
                        <Grid
                            Grid.Row="7"
                            Grid.ColumnSpan="3"
                            MinHeight="60"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="400" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" Text="48px" />
                            <Border Grid.Column="1" Width="48" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="4" />
                            <TextBlock Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="Spacing between page sections with title." TextWrapping="Wrap" />
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
