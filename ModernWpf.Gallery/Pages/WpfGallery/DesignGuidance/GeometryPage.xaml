<Page
    x:Class="ModernWpf.Gallery.Pages.WpfGallery.DesignGuidance.GeometryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ModernWpf.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="GeometryPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="ContentPagePane" Height="Auto">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader
            Margin="0,0,0,32"
            ShowDescription="False"
            Title="{Binding ViewModel.PageTitle}" />

        <ScrollViewer
            Grid.Row="1"
            Margin="0,0,0,24"
            Padding="0,0,24,0"
            HorizontalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,24" Orientation="Vertical">
                <TextBlock
                    HorizontalAlignment="Left"
                    TextWrapping="Wrap">
                    Geometry describes the shape, size and position of UI elements on screen.
                </TextBlock>
                <TextBlock
                    HorizontalAlignment="Left"
                    TextWrapping="Wrap">
                    These fundamental design elements help experiences feel coherent across the entire design system.
                </TextBlock>
                <TextBlock
                    Margin="0,0,0,12"
                    HorizontalAlignment="Left"
                    TextWrapping="Wrap">
                    You can reference built-in corner radii styles using: CornerRadius="{StaticResource ControlCornerRadius}" .
                </TextBlock>

                <Border
                    Width="500"
                    Height="300"
                    HorizontalAlignment="Left">
                    <Image
                        x:Name="GeometryImage"
                        AutomationProperties.Name="Example of corner radius." />
                </Border>

                <controls:ControlExample XamlCode="&lt;Border CornerRadius=&quot;{StaticResource OverlayCornerRadius}&quot; /&gt;&#x0a;&lt;Border CornerRadius=&quot;{StaticResource ControlCornerRadius}&quot; /&gt;">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Grid Margin="0,0,0,24" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="148" />
                                    <ColumnDefinition Width="400" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Margin="16,0,0,0"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Opacity="0.7"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Corner radius" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="16,0,0,0"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Opacity="0.7"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Usage" />
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="16,0,0,0"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Opacity="0.7"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Style" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <Grid MinHeight="60" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="148" />
                                        <ColumnDefinition Width="400" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Border
                                            Width="20"
                                            Height="20"
                                            Margin="16,0,0,0"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            CornerRadius="{DynamicResource OverlayCornerRadius}" />
                                        <TextBlock
                                            Margin="16,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="8px" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Top-level containers such as app windows, flyouts, cards and dialogs."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="OverlayCornerRadius"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <Border>
                                <Grid MinHeight="60" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="148" />
                                        <ColumnDefinition Width="400" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Border
                                            Width="20"
                                            Height="20"
                                            Margin="16,0,0,0"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            CornerRadius="{DynamicResource ControlCornerRadius}" />
                                        <TextBlock
                                            Margin="16,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="4px" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="In-page elements such as controls and list backplates."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="ControlCornerRadius"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="3">
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <Grid MinHeight="60" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="148" />
                                        <ColumnDefinition Width="400" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Border
                                            Width="20"
                                            Height="20"
                                            Margin="16,0,0,0"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <TextBlock
                                            Margin="16,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="0px" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Straight edges that intersect with other straight edges."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="N/A"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </controls:ControlExample>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
