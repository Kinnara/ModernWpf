<UserControl
    x:Class="ModernWpf.Gallery.Pages.WpfGallery.SystemPages.MessageBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ModernWpf.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ModernWpf.Gallery.Pages.WpfGallery.SystemPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="ContentPagePane" Height="Auto">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader
            Margin="0,0,0,32"
            ShowDescription="False"
            Title="{Binding ViewModel.PageTitle}" />

        <ScrollViewer
            Grid.Row="1"
            Margin="0,0,0,24"
            Padding="0,0,24,0">
            <StackPanel>
                <controls:ControlExample
                    Margin="10"
                    CSharpCode="private void ShowDefaultMessageButton_Click(object sender, RoutedEventArgs e)&#x0a;{&#x0a;    var result = MessageBox.Show(&quot;This is a simple message box!&quot;);&#x0a;}"
                    HeaderText="Simple MessageBox"
                    XamlCode="&lt;Button Content=&quot;Simple MessageBox&quot; Click=&quot;ShowDefaultMessageButton_Click&quot; /&gt;">
                    <StackPanel>
                        <Button
                            Margin="0,0,0,10"
                            Click="ShowDefaultMessageButton_Click"
                            Content="Simple MessageBox" />
                        <TextBlock Text="{Binding ViewModel.DefaultMessageResult, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:MessageBoxPage}}" TextWrapping="Wrap" />
                    </StackPanel>
                </controls:ControlExample>

                <controls:ControlExample
                    Margin="10,32,10,10"
                    CSharpCode="private void ShowCustomTitleButton_Click(object sender, RoutedEventArgs e)&#x0a;{&#x0a;    var result = MessageBox.Show(&#x0a;        &quot;This is a detailed description of what happened or what action is needed.&quot;,&#x0a;        &quot;Custom Title&quot;);&#x0a;}"
                    HeaderText="MessageBox with Custom Title and Description"
                    XamlCode="&lt;Button Content=&quot;Show MessageBox&quot; Click=&quot;ShowCustomTitleButton_Click&quot; /&gt;">
                    <StackPanel>
                        <Button
                            Margin="0,0,0,10"
                            Click="ShowCustomTitleButton_Click"
                            Content="Custom MessageBox" />
                        <TextBlock Text="{Binding ViewModel.CustomTitleResult, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:MessageBoxPage}}" TextWrapping="Wrap" />
                    </StackPanel>
                </controls:ControlExample>

                <controls:ControlExample
                    Margin="10,32,10,10"
                    CSharpCode="{Binding ViewModel.DifferentButtonsCSharpCode, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:MessageBoxPage}}"
                    HeaderText="MessageBox with Different Buttons"
                    XamlCode="{Binding ViewModel.DifferentButtonsXamlCode, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:MessageBoxPage}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Button
                                Margin="0,0,0,10"
                                AutomationProperties.Name="MessageBox with Different Buttons"
                                Click="ShowButtonFromComboBox_Click"
                                Content="Show MessageBox" />
                            <TextBlock Text="{Binding ViewModel.DifferentButtonsResult, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:MessageBoxPage}}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Margin="10,0,0,0">
                            <TextBlock Margin="0,0,0,5" Text="Button Type:" />
                            <ComboBox
                                x:Name="ButtonTypeComboBox"
                                MinWidth="150"
                                AutomationProperties.Name="MessageBox Button Selector"
                                SelectedIndex="{Binding ViewModel.SelectedButtonIndex, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:MessageBoxPage}}">
                                <ComboBoxItem Content="OK" />
                                <ComboBoxItem Content="OK/Cancel" />
                                <ComboBoxItem Content="Abort/Retry/Ignore" />
                                <ComboBoxItem Content="Yes/No/Cancel" />
                                <ComboBoxItem Content="Yes/No" />
                                <ComboBoxItem Content="Retry/Cancel" />
                                <ComboBoxItem Content="Cancel/Try/Continue" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </controls:ControlExample>

                <controls:ControlExample
                    Margin="10,32,10,10"
                    CSharpCode="{Binding ViewModel.DifferentImagesCSharpCode, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:MessageBoxPage}}"
                    HeaderText="MessageBox with Different Images"
                    XamlCode="{Binding ViewModel.DifferentImagesXamlCode, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:MessageBoxPage}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Button
                                Margin="0,0,0,10"
                                AutomationProperties.Name="MessageBox with different images"
                                Click="ShowImageFromComboBox_Click"
                                Content="Show MessageBox" />
                            <TextBlock Text="{Binding ViewModel.DifferentImagesResult, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:MessageBoxPage}}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Margin="10,0,0,0">
                            <TextBlock Margin="0,0,0,5" Text="Icon Type:" />
                            <ComboBox
                                x:Name="ImageTypeComboBox"
                                MinWidth="150"
                                AutomationProperties.Name="MessageBox Image Selector"
                                SelectedIndex="{Binding ViewModel.SelectedImageIndex, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:MessageBoxPage}}">
                                <ComboBoxItem Content="None" />
                                <ComboBoxItem Content="Error" />
                                <ComboBoxItem Content="Question" />
                                <ComboBoxItem Content="Warning" />
                                <ComboBoxItem Content="Information" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </controls:ControlExample>

                <controls:ControlExample
                    Margin="10,32,10,10"
                    CSharpCode="{Binding ViewModel.CommonMessagesCSharpCode, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:MessageBoxPage}}"
                    HeaderText="Information, Error, and Warning MessageBox"
                    XamlCode="{Binding ViewModel.CommonMessagesXamlCode, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:MessageBoxPage}}">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,10">
                            <Button
                                Margin="0,0,5,0"
                                Click="ShowCommonInformation_Click"
                                Content="Information" />
                            <Button
                                Margin="0,0,5,0"
                                Click="ShowCommonError_Click"
                                Content="Error" />
                            <Button Click="ShowCommonWarning_Click" Content="Warning" />
                        </WrapPanel>
                        <TextBlock Text="{Binding ViewModel.CommonMessagesResult, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:MessageBoxPage}}" TextWrapping="Wrap" />
                    </StackPanel>
                </controls:ControlExample>

                <controls:ControlExample
                    Margin="10,32,10,10"
                    CSharpCode="private void ShowCustomDefaultButton_Click(object sender, RoutedEventArgs e)&#x0a;{&#x0a;    // Set 'No' as the default button (focused when dialog opens)&#x0a;    var result = MessageBox.Show(&#x0a;        &quot;Do you want to save changes? Press Enter to select the default 'No' button.&quot;,&#x0a;        &quot;Save Changes&quot;,&#x0a;        MessageBoxButton.YesNoCancel,&#x0a;        MessageBoxImage.Question,&#x0a;        MessageBoxResult.No);&#x0a;}"
                    HeaderText="MessageBox with Custom Default Button"
                    XamlCode="&lt;Button Content=&quot;Show with 'No' as default&quot; Click=&quot;ShowCustomDefaultButton_Click&quot; /&gt;">
                    <StackPanel>
                        <Button
                            Margin="0,0,0,10"
                            Click="ShowCustomDefaultButton_Click"
                            Content="Show with 'No' as default" />
                        <TextBlock Text="{Binding ViewModel.CustomDefaultResult, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:MessageBoxPage}}" TextWrapping="Wrap" />
                    </StackPanel>
                </controls:ControlExample>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
