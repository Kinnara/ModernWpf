<UserControl
    x:Class="ModernWpf.Gallery.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="GalleryCard.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Style="{StaticResource GalleryPageRootStyle}">
        <ScrollViewer>
            <Grid Margin="0,0,0,48">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.RowSpan="2"
                    CornerRadius="8,0,0,0">
                    <Border.Background>
                        <ImageBrush
                            ImageSource="pack://application:,,,/ModernWpf.Gallery;component/Assets/win11-dashboard.light.png"
                            Stretch="UniformToFill" />
                    </Border.Background>
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Black" Offset="0.6" />
                            <GradientStop Color="Transparent" Offset="0.9" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>

                <Border
                    Height="220"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,0,0,0">
                    <StackPanel Margin="36,48,0,0" VerticalAlignment="Top">
                        <TextBlock
                            Margin="0,0,0,2"
                            Foreground="Black"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="ModernWpf" />
                        <TextBlock
                            Margin="0,0,0,8"
                            Foreground="Black"
                            Style="{StaticResource TitleLargeTextBlockStyle}"
                            Text="WPF Gallery" />
                        <TextBlock
                            MaxWidth="330"
                            Padding="0,8,12,8"
                            HorizontalAlignment="Left"
                            Foreground="Black"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="A WPF-first gallery that combines official WPF Gallery visuals with WinUI-style controls implemented by ModernWpf." />
                    </StackPanel>
                </Border>

                <ItemsControl
                    Grid.Row="1"
                    Margin="18,0,0,0"
                    ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Width="198"
                                Height="220"
                                Margin="6"
                                Padding="24"
                                BorderThickness="1"
                                Click="OnGroupCardClick"
                                Content="{Binding}"
                                ContentTemplate="{StaticResource GalleryTileCardTemplate}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel
                    Grid.Row="2"
                    Margin="32,24,24,0"
                    Orientation="Vertical">
                    <DockPanel Margin="0,0,0,6">
                        <Button
                            DockPanel.Dock="Right"
                            Content="View all controls"
                            Click="OnAllControlsClick" />
                        <TextBlock
                            FontSize="16"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Overview" />
                    </DockPanel>

                    <ItemsControl
                        Margin="-7,0,0,0"
                        ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Click="OnGroupCardClick"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource GalleryGroupCardTemplate}"
                                    Style="{StaticResource GalleryCardButtonStyle}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock
                        FontSize="16"
                        Style="{StaticResource GallerySectionHeaderTextBlockStyle}"
                        Text="Recently added and updated" />

                    <ItemsControl
                        Margin="-7,0,0,0"
                        ItemsSource="{Binding FeaturedItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Click="OnItemCardClick"
                                Content="{Binding}"
                                ContentTemplate="{StaticResource GalleryItemCardTemplate}"
                                Style="{StaticResource GalleryCardButtonStyle}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
