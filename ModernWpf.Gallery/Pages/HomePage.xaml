<UserControl
    x:Class="ModernWpf.Gallery.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="GalleryCard.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        AutomationProperties.AutomationId="ContentRootGrid"
        Style="{StaticResource GalleryPageRootStyle}">
        <ScrollViewer>
            <Grid Margin="0,0,0,48">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.RowSpan="2"
                    CornerRadius="8,0,0,0">
                    <Border.Background>
                        <ImageBrush
                            ImageSource="pack://application:,,,/ModernWpf.Gallery;component/Assets/win11-dashboard.light.png"
                            Stretch="UniformToFill" />
                    </Border.Background>
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Black" Offset="0.6" />
                            <GradientStop Color="Transparent" Offset="0.9" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>

                <Border
                    Height="220"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,0,0,0">
                    <StackPanel
                        Margin="36,48,0,0"
                        TextElement.Foreground="Black"
                        VerticalAlignment="Top">
                        <TextBlock
                            Margin="0,0,0,2"
                            Foreground="Black"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text=".NET 10" />
                        <TextBlock
                            Margin="0,0,0,8"
                            Foreground="Black"
                            Style="{StaticResource TitleLargeTextBlockStyle}"
                            Text="WPF Gallery" />
                        <Border
                            MaxWidth="300"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            CornerRadius="8">
                            <TextBlock
                                MaxWidth="300"
                                Padding="0,8,12,8"
                                HorizontalAlignment="Left"
                                Foreground="Black"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="A collection of controls, guidelines and samples to build great WPF applications"
                                TextAlignment="Left" />
                        </Border>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                <ScrollViewer
                    Margin="24,0,0,0"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource GalleryHeaderTileButtonStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="56" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Image
                                Width="48"
                                Height="48"
                                HorizontalAlignment="Left"
                                Source="pack://application:,,,/ModernWpf.Gallery;component/Assets/Tiles/GalleryIcon.ico" />
                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="18"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="Getting started" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="An overview of app development options, tools, and samples." />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource GalleryHeaderTileButtonStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="56" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Image
                                Width="56"
                                Height="56"
                                HorizontalAlignment="Left"
                                Source="pack://application:,,,/ModernWpf.Gallery;component/Assets/HomeHeaderTiles/Header-WindowsDesign.png" />
                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="18"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="Windows design" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Design guidelines and toolkits for creating native app experiences." />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource GalleryHeaderTileButtonStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="56" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="42"
                                Text="&#xE8A7;" />
                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="18"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="WPF GitHub" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="A robust UI framework for your desktop applications." />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource GalleryHeaderTileButtonStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="56" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="42"
                                Text="&#xE8A7;" />
                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="18"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="Code samples" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Find WPF samples that demonstrate specific tasks, features, and APIs." />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource GalleryHeaderTileButtonStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="56" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Image
                                Width="56"
                                Height="56"
                                HorizontalAlignment="Left"
                                Source="pack://application:,,,/ModernWpf.Gallery;component/Assets/HomeHeaderTiles/Header-Store.dark.png" />
                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="18"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="Partner Center" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Upload your app to the Store." />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>
                </ScrollViewer>
                    <Button
                        Margin="8,-16,0,0"
                        HorizontalAlignment="Left"
                        Style="{StaticResource GalleryHeaderTileScrollButtonStyle}"
                        ToolTip="Scroll left">
                        <TextBlock
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="8"
                            Text="&#xEDD9;" />
                    </Button>
                    <Button
                        Margin="0,-16,8,0"
                        HorizontalAlignment="Right"
                        Style="{StaticResource GalleryHeaderTileScrollButtonStyle}"
                        ToolTip="Scroll right">
                        <TextBlock
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="8"
                            Text="&#xEDDA;" />
                    </Button>
                </Grid>

                <StackPanel
                    Grid.Row="2"
                    Margin="32,24,0,0"
                    Orientation="Vertical">
                    <TextBlock
                        FontSize="16"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Overview" />

                    <ItemsControl
                        Margin="-20,0,0,0"
                        ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Click="OnGroupCardClick"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource GalleryGroupCardTemplate}"
                                    Style="{StaticResource GalleryCardButtonStyle}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock
                        FontSize="16"
                        Style="{StaticResource GallerySectionHeaderTextBlockStyle}"
                        Text="Recently added and updated" />

                    <ItemsControl
                        Margin="-18,0,0,0"
                        ItemsSource="{Binding FeaturedItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Click="OnItemCardClick"
                                Content="{Binding}"
                                ContentTemplate="{StaticResource GalleryItemCardTemplate}"
                                Style="{StaticResource GalleryCardButtonStyle}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
