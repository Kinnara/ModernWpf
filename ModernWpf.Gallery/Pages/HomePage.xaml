<UserControl
    x:Class="ModernWpf.Gallery.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ModernWpf.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="900"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="GalleryCard.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        AutomationProperties.AutomationId="ContentRootGrid"
        Margin="-24,-16,-24,12"
        Style="{StaticResource GalleryPageRootStyle}">
        <ScrollViewer>
            <Grid x:Name="HomeContentGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.RowSpan="2"
                    CornerRadius="8,0,0,0">
                    <Border.Background>
                        <ImageBrush
                            ImageSource="pack://application:,,,/ModernWpf.Gallery;component/Assets/win11-dashboard.light.png"
                            Stretch="UniformToFill" />
                    </Border.Background>
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Black" Offset="0.6" />
                            <GradientStop Color="Transparent" Offset="0.9" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>

                <Border
                    Height="220"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,0,0,0">
                    <StackPanel
                        Margin="36,48,0,0"
                        TextElement.Foreground="Black"
                        VerticalAlignment="Top">
                        <TextBlock
                            x:Name="HeroVersionText"
                            Margin="0,0,0,2"
                            Foreground="Black"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text=".NET 10" />
                        <TextBlock
                            x:Name="HeroTitleText"
                            Margin="0,0,0,8"
                            Foreground="Black"
                            Style="{StaticResource TitleLargeTextBlockStyle}"
                            Text="WPF Gallery" />
                        <Border
                            MaxWidth="300"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            CornerRadius="8">
                            <TextBlock
                                MaxWidth="300"
                                Padding="0,8,12,8"
                                HorizontalAlignment="Left"
                                Foreground="Black"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="A collection of controls, guidelines and samples to build great WPF applications"
                                TextAlignment="Left" />
                        </Border>
                    </StackPanel>
                </Border>

                <controls:TileGallery
                    x:Name="HomeTileGallery"
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    Margin="0" />

                <StackPanel
                    Grid.Row="2"
                    Margin="32,24,0,0"
                    Orientation="Vertical">
                    <TextBlock
                        x:Name="OverviewHeaderText"
                        FontSize="16"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Overview" />

                    <ItemsControl
                        x:Name="OverviewItemsControl"
                        AutomationProperties.Name="Items in group"
                        Focusable="False"
                        Margin="-20,0,0,0"
                        ItemsSource="{Binding ViewModel.NavigationCards}"
                        ItemsPanel="{StaticResource WrapPanelTemplate}"
                        ItemTemplate="{StaticResource NavigationCardTemplate}" />

                    <TextBlock
                        x:Name="RecentlyAddedHeaderText"
                        FontSize="16"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Recently added and updated" />

                    <ItemsControl
                        x:Name="RecentlyAddedItemsControl"
                        AutomationProperties.Name="Recently Added and Updated Samples Section"
                        Focusable="False"
                        Margin="-18,0,0,0"
                        ItemsSource="{Binding ViewModel.RecentlyAddedOrUpdatedSamplesInfo}"
                        ItemsPanel="{StaticResource WrapPanelTemplate}"
                        ItemTemplate="{StaticResource NavigationCardTemplate}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
