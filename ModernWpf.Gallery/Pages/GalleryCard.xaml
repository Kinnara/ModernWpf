<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="GalleryItemCardTemplate">
        <StackPanel Orientation="Horizontal">
            <Image
                Width="50"
                Height="50"
                Margin="0,0,8,0"
                Source="{Binding ImagePath}"
                Stretch="Uniform" />
            <StackPanel Orientation="Vertical">
                <DockPanel Width="240" LastChildFill="True">
                    <Border
                        DockPanel.Dock="Right"
                        Padding="8,2"
                        Margin="8,0,0,0"
                        Background="{DynamicResource SystemControlHighlightAccentBrush}"
                        CornerRadius="4"
                        Visibility="{Binding HasBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            FontSize="11"
                            Foreground="White"
                            Text="{Binding Badge}" />
                    </Border>
                    <TextBlock
                        Margin="10,0,0,0"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{Binding Title}" />
                </DockPanel>
                <TextBlock
                    Width="240"
                    Margin="10,0,0,0"
                    Opacity="0.7"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding Subtitle}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="GalleryGroupCardTemplate">
        <StackPanel Orientation="Horizontal">
            <Image
                Width="50"
                Height="50"
                Margin="0,0,8,0"
                Source="{Binding ImagePath}"
                Stretch="Uniform" />
            <StackPanel Orientation="Vertical">
                <TextBlock
                    Width="240"
                    Margin="10,0,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{Binding Title}" />
                <TextBlock
                    Width="240"
                    Margin="10,0,0,0"
                    Opacity="0.7"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding Subtitle}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="GalleryTileCardTemplate">
        <Grid>
            <StackPanel Margin="18,14">
                <Image
                    Width="42"
                    Height="42"
                    HorizontalAlignment="Left"
                    Source="{Binding ImagePath}"
                    Stretch="Uniform" />
                <TextBlock
                    Margin="0,12,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{Binding Title}" />
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
