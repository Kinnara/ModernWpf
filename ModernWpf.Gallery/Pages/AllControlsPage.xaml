<UserControl
    x:Class="ModernWpf.Gallery.Pages.AllControlsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="GalleryCard.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Style="{StaticResource GalleryPageRootStyle}">
        <ScrollViewer>
            <StackPanel Margin="32,24,24,48">
                <Label
                    Padding="0"
                    Focusable="True"
                    KeyboardNavigation.IsTabStop="True">
                    <TextBlock
                        Style="{StaticResource GalleryTitleTextBlockStyle}"
                        Text="All controls" />
                </Label>
                <Label
                    Padding="0"
                    Margin="0,0,0,24"
                    Focusable="True"
                    KeyboardNavigation.IsTabStop="True">
                    <TextBlock
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Browse every WPF and WinUI-derived gallery entry tracked by the ModernWpf catalog." />
                </Label>
                <TextBox
                    x:Name="FilterBox"
                    Width="360"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,24"
                    TextChanged="OnFilterTextChanged" />
                <ItemsControl
                    Margin="-7,0,0,0"
                    ItemsSource="{Binding FilteredItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Click="OnItemCardClick"
                                Content="{Binding}"
                                ContentTemplate="{StaticResource GalleryItemCardTemplate}"
                                Style="{StaticResource GalleryCardButtonStyle}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
