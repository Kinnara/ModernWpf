<UserControl
    x:Class="ModernWpf.Gallery.Pages.ItemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="760"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <Grid Style="{StaticResource GalleryPageRootStyle}">
        <ScrollViewer>
            <StackPanel Margin="40,32,40,48">
                <DockPanel>
                    <Border
                        DockPanel.Dock="Left"
                        Width="72"
                        Height="72"
                        Margin="0,0,24,0"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                        <Image
                            Width="44"
                            Height="44"
                            Source="{Binding ImagePath}"
                            Stretch="Uniform" />
                    </Border>
                    <StackPanel>
                        <TextBlock
                            Style="{StaticResource GalleryTitleTextBlockStyle}"
                            Text="{Binding Title}" />
                        <TextBlock
                            Style="{StaticResource GallerySubtitleTextBlockStyle}"
                            Text="{Binding Subtitle}" />
                    </StackPanel>
                </DockPanel>

                <TextBlock
                    Text="{Binding Description}"
                    TextWrapping="Wrap" />

                <TextBlock
                    Style="{StaticResource GallerySectionHeaderTextBlockStyle}"
                    Text="WPF sample"
                    Visibility="{Binding HasWpfSampleContent, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ContentControl
                    Content="{Binding WpfSampleContent}"
                    Visibility="{Binding HasWpfSampleContent, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            Style="{StaticResource GallerySectionHeaderTextBlockStyle}"
                            Text="API" />
                        <TextBlock
                            Style="{StaticResource GalleryMetaTextBlockStyle}"
                            Text="{Binding ApiNamespace}" />
                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{StaticResource GalleryMetaTextBlockStyle}"
                            Text="{Binding BaseClassText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock
                            Style="{StaticResource GallerySectionHeaderTextBlockStyle}"
                            Text="Source" />
                        <TextBlock
                            Style="{StaticResource GalleryMetaTextBlockStyle}"
                            Text="{Binding GroupTitle}" />
                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{StaticResource GalleryMetaTextBlockStyle}"
                            Text="{Binding UniqueId}" />
                    </StackPanel>
                </Grid>

                <TextBlock
                    Style="{StaticResource GallerySectionHeaderTextBlockStyle}"
                    Text="Documentation" />
                <ItemsControl ItemsSource="{Binding Docs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,0,0,8">
                                <Hyperlink NavigateUri="{Binding Uri}" RequestNavigate="OnDocumentationRequestNavigate">
                                    <Run Text="{Binding Title}" />
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    Style="{StaticResource GallerySectionHeaderTextBlockStyle}"
                    Text="Original WinUI Gallery sample code" />
                <ItemsControl ItemsSource="{Binding SampleSnippets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander
                                Margin="0,0,0,8"
                                Header="{Binding Title}">
                                <TextBox
                                    AcceptsReturn="True"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    HorizontalScrollBarVisibility="Auto"
                                    IsReadOnly="True"
                                    Text="{Binding Text}"
                                    TextWrapping="NoWrap"
                                    VerticalScrollBarVisibility="Auto" />
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    Style="{StaticResource GallerySectionHeaderTextBlockStyle}"
                    Text="Related controls" />
                <ItemsControl ItemsSource="{Binding RelatedItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Width="180"
                                Margin="0,0,8,8"
                                Click="OnRelatedItemClick"
                                Content="{Binding Title}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
