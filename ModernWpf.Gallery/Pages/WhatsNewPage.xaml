<UserControl
    x:Class="ModernWpf.Gallery.Pages.WhatsNewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ModernWpf.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="900"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="WhatsNewSubHeaderTextStyle"
            BasedOn="{StaticResource SubtitleTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style
            x:Key="WhatsNewParagraphTextStyle"
            BasedOn="{StaticResource BodyTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid
        AutomationProperties.AutomationId="ContentRootGrid"
        Style="{StaticResource GalleryPageRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,32">
            <Label
                x:Name="TitleLabel"
                AutomationProperties.Name="What's new in WPF Page"
                Focusable="True"
                KeyboardNavigation.IsTabStop="True"
                KeyboardNavigation.TabIndex="0">
                <TextBlock
                    x:Name="WhatsNewTitleTextBlock"
                    AutomationProperties.AutomationId="GalleryWhatsNewPageTitle"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="What's new in WPF" />
            </Label>
            <Label
                x:Name="DescriptionLabel"
                Focusable="True"
                KeyboardNavigation.IsTabStop="True"
                KeyboardNavigation.TabIndex="1">
                <TextBlock
                    x:Name="WhatsNewDescriptionTextBlock"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Discover all the new features, enhancements and APIs introduced in WPF" />
            </Label>
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            Margin="0,0,0,24"
            Padding="0,0,24,0">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,12"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text=".NET 10" />

                <TextBlock Style="{StaticResource WhatsNewSubHeaderTextStyle}" Text="New and Enhanced Fluent Styles" />

                <TextBlock Style="{StaticResource WhatsNewParagraphTextStyle}">
                    <Run>
                        Fluent styles for remaining PresentationFramework controls have been added in .NET 10, including GridSplitter, GridView,
                        GroupBox, Label, Frame, NavigationWindow, etc.
                    </Run>
                    <Run>
                        Apart from the added styles, styles for many other controls like text input controls, DataGrid, Expander have been updated
                        to eliminate various issues like right-to-left layout, same height for various input controls, etc.
                    </Run>
                    <LineBreak />
                    <LineBreak />
                    <Run>See the </Run>
                    <Bold>Recently Added</Bold>
                    <Run> section on the Home page to see the complete list of added samples.</Run>
                    <LineBreak />
                </TextBlock>

                <TextBlock Style="{StaticResource WhatsNewSubHeaderTextStyle}" Text="Grid Shorthand Syntax" />

                <TextBlock Style="{StaticResource WhatsNewParagraphTextStyle}">
                    The WPF Grid supports a shorthand syntax for defining row and column sizes using the RowDefinitions and ColumnDefinitions attribute.
                    Values are comma-separated and follow the same rules as the longhand RowDefinition and ColumnDefinition declarations. The new syntax
                    comes with the XAML Hot Reload support.
                </TextBlock>

                <controls:ControlExample
                    x:Name="GridShorthandSyntaxExample"
                    Margin="2,10,2,24"
                    HeaderText="Grid Shorthand Syntax Sample"
                    XamlCode="{Binding GridShorthandSyntaxXamlCode}">
                    <Grid HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,10,0"
                            FontWeight="Bold"
                            Text="Sl. No." />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            FontWeight="Bold"
                            Text="Name" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            FontWeight="Bold"
                            Text="Description" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="1" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="Rectangle" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            Text="Quadrilateral where all the adjacent sides form a right angle."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Text="2" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Text="Circle" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="2"
                            Text="Set of all points that are equidistant from a fixed point."
                            TextWrapping="Wrap" />
                    </Grid>
                </controls:ControlExample>

                <TextBlock Style="{StaticResource WhatsNewSubHeaderTextStyle}" Text="Extended MessageBox Options" />

                <TextBlock Style="{StaticResource WhatsNewParagraphTextStyle}">
                    <Run>
                        MessageBox in WPF calls into the Win32 API for displaying the message dialog box, however some of the options provided by the API
                        was not exposed till now. Thanks to the help from the community we have exposed those options and results in WPF's Messagebox API,
                        allowing developers to make full use of MessageBox in WPF without calling the Win32 API directly. Take a look at the API proposal
                        for complete details on what is added :
                    </Run>
                    <Hyperlink Click="OnMessageBoxSpecClick">[API Proposal]: Make additional MessageBoxButton and MessagBoxResult values available</Hyperlink>
                    <LineBreak />
                    <LineBreak />
                    <Run>Head over to the </Run>
                    <Hyperlink Click="OnMessageBoxSampleClick">MessageBox sample </Hyperlink>
                    <Run>for details on how to use the MessageBox in WPF.</Run>
                </TextBlock>

                <TextBlock
                    Margin="0,12,0,24"
                    Style="{StaticResource WhatsNewParagraphTextStyle}">
                    <Run>See </Run>
                    <Hyperlink Click="OnWhatsNewNet10Click">What's New in WPF for .NET 10</Hyperlink>
                    <Run> for more details.</Run>
                </TextBlock>

                <TextBlock
                    Margin="0,0,0,12"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text=".NET 9" />

                <TextBlock Style="{StaticResource WhatsNewSubHeaderTextStyle}" Text="Accent colors as SystemColors" />

                <TextBlock Style="{StaticResource WhatsNewParagraphTextStyle}">
                    Since Windows 10, Accent Color became a cornerstone for visual
                    styling, enhancing consistency across apps by aligning with
                    the system theme.
                    The latest introduction of AccentColors and corresponding
                    brushes in SystemColors simplifies this process
                    for WPF developers, offering them direct access to
                    system accent colors and their variations.
                </TextBlock>

                <TextBlock Style="{StaticResource WhatsNewParagraphTextStyle}">
                    <Bold>NOTE : </Bold>
                    <Run>
                        In HighContrast mode, all the AccentColor brushes and colors have the same value, and we won't see a difference in the brushes.
                    </Run>
                </TextBlock>

                <controls:ControlExample
                    x:Name="AccentColorExample"
                    Margin="2,10"
                    HeaderText="AccentColor API"
                    XamlCode="{Binding AccentColorXamlCode}">
                    <Grid>
                        <StackPanel
                            x:Name="AccentColorSwatches"
                            Height="50"
                            Orientation="Horizontal">
                            <StackPanel.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="Height" Value="50" />
                                    <Setter Property="Width" Value="30" />
                                </Style>
                            </StackPanel.Resources>
                            <Border
                                Background="{DynamicResource SystemAccentColorDark3Brush}"
                                CornerRadius="2,0,0,2" />
                            <Border Background="{DynamicResource SystemAccentColorDark2Brush}" />
                            <Border Background="{DynamicResource SystemAccentColorDark1Brush}" />
                            <Border Background="{DynamicResource SystemControlBackgroundAccentBrush}" />
                            <Border Background="{DynamicResource SystemAccentColorLight1Brush}" />
                            <Border Background="{DynamicResource SystemAccentColorLight2Brush}" />
                            <Border
                                Background="{DynamicResource SystemAccentColorLight3Brush}"
                                CornerRadius="0,2,2,0" />
                        </StackPanel>
                    </Grid>
                </controls:ControlExample>

                <TextBlock
                    Margin="0,24,0,12"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="[ Experimental ] ThemeMode API" />

                <TextBlock Style="{StaticResource WhatsNewParagraphTextStyle}">
                    <Run>
                        This experimental API enables easy switching between Fluent Themes in WPF
                        applications, improving user experience and accessibility.
                        This experimental API, available at both the Application and
                        Window level, allows developers to dynamically toggle between
                        Light, Dark, System, or None (Default) themes, offering
                        greater flexibility in adapting app visuals.
                    </Run>
                    <LineBreak />
                    <LineBreak />
                    <Run>
                        Since the API is experimental, the usage of ThemeMode from
                        code-behind is a bit restricted. To use ThemeMode from
                        code-behind, the developer either needs to configure
                        the project to ignore the
                    </Run>
                    <Bold> WPF0001 </Bold>
                    <Run>
                        warning for the project
                        or suppress the warning where needed.
                    </Run>
                    <LineBreak />
                    <LineBreak />
                    <Run>See </Run>
                    <Hyperlink Click="OnUsingFluentInWpfClick">Using Fluent theme in WPF in .NET 9</Hyperlink>
                    <Run> for more information.</Run>
                </TextBlock>

                <TextBlock
                    Margin="0,24,0,12"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Hyphen based ligature support" />

                <TextBlock Style="{StaticResource WhatsNewParagraphTextStyle}">
                    Based on the WPF community feedback, we have now fixed the
                    issue with Hyphen based ligatures not working in WPF.
                </TextBlock>

                <controls:ControlExample
                    x:Name="HyphenLigatureExample"
                    Margin="2,10"
                    HeaderText="Hyphen based ligature example"
                    XamlCode="{Binding HyphenBasedLigatureXamlCode}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,16,0"
                            FontFamily="Cascadia Code"
                            Text="--&gt;" />
                        <TextBlock
                            Margin="0,0,16,0"
                            FontFamily="Cascadia Code"
                            Text="&lt;!--" />
                        <TextBlock
                            Margin="0,0,16,0"
                            FontFamily="Cascadia Code"
                            Text="&lt;--" />
                    </StackPanel>
                </controls:ControlExample>

                <TextBlock
                    Margin="0,24,0,12"
                    Style="{StaticResource WhatsNewParagraphTextStyle}">
                    <Run>See </Run>
                    <Hyperlink Click="OnWhatsNewNet9Click">What's New in WPF for .NET 9</Hyperlink>
                    <Run> for more details.</Run>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
