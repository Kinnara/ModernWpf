<UserControl
    x:Class="ModernWpf.Gallery.Pages.SectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="GalleryCard.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        AutomationProperties.AutomationId="ContentRootGrid"
        Style="{StaticResource GalleryPageRootStyle}">
        <ScrollViewer>
            <Grid Margin="0,0,0,48">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,40"
                    VerticalAlignment="Center">
                    <Label
                        x:Name="TitleLabel"
                        Focusable="True"
                        KeyboardNavigation.IsTabStop="True"
                        KeyboardNavigation.TabIndex="0">
                        <TextBlock
                            Style="{StaticResource TitleTextBlockStyle}"
                            Text="{Binding Title}" />
                    </Label>
                    <Label
                        x:Name="DescriptionLabel"
                        Focusable="True"
                        KeyboardNavigation.IsTabStop="True"
                        KeyboardNavigation.TabIndex="1">
                        <TextBlock
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{Binding PageDescription}" />
                    </Label>
                </StackPanel>

                <ItemsControl
                    x:Name="GroupItemsControl"
                    Grid.Row="1"
                    AutomationProperties.Name="Items in group"
                    Focusable="False"
                    Margin="-12,0,0,0"
                    ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Margin="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                AutomationProperties.Name="{Binding Title, StringFormat='{}{0}Page'}"
                                Click="OnItemCardClick"
                                Content="{Binding}"
                                ContentTemplate="{StaticResource GalleryItemCardTemplate}"
                                Style="{StaticResource GalleryCardButtonStyle}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
