<Window
    x:Class="ModernWpf.Gallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:galleryShell="clr-namespace:ModernWpf.Gallery.Shell"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:winShell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="WPF Gallery"
    Width="1180"
    Height="820"
    MinWidth="840"
    MinHeight="560"
    AutomationProperties.AutomationId="ModernWpfGalleryMainWindow"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d"
    ui:ThemeManager.IsThemeAware="True">
    <Window.Resources>
        <Style x:Key="GalleryTitleBarButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Border.CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="EnclosingBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding Border.CornerRadius}"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EnclosingBorder" Property="Background" Value="{DynamicResource ControlAltFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="EnclosingBorder" Property="Background" Value="{DynamicResource ControlAltFillColorQuarternaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <winShell:WindowChrome.WindowChrome>
        <winShell:WindowChrome
            CaptionHeight="44"
            CornerRadius="12"
            GlassFrameThickness="-1"
            ResizeBorderThickness="4"
            UseAeroCaptionButtons="True" />
    </winShell:WindowChrome.WindowChrome>

    <Border
        x:Name="HighContrastBorder"
        BorderBrush="Transparent"
        BorderThickness="0">
        <Grid x:Name="MainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="AppTitleBar"
                Grid.Row="0"
                Height="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="BackButton"
                    Width="36"
                    Height="36"
                    MinWidth="36"
                    Margin="8,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Back"
                    Click="BackButton_Click"
                    IsEnabled="False"
                    Style="{StaticResource GalleryTitleBarButtonStyle}"
                    ToolTipService.ToolTip="Back"
                    winShell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="12"
                        Text="&#xE72B;">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <StackPanel
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    Orientation="Horizontal">
                    <Image
                        x:Name="TitleIcon"
                        Width="20"
                        VerticalAlignment="Center"
                        Source="pack://application:,,,/ModernWpf.Gallery;component/Assets/AppIcons/WPFGallery_48px.png" />
                    <TextBlock
                        x:Name="TitleText"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="WPF Gallery" />
                </StackPanel>
            </Grid>

            <galleryShell:NavigationRootPage
                x:Name="RootPage"
                Grid.Row="1" />
        </Grid>
    </Border>
</Window>
