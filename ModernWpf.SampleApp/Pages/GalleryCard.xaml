<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="GalleryItemCardTemplate">
        <Grid MinHeight="136">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="12,18,12,0"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                <Image
                    Width="32"
                    Height="32"
                    Source="{Binding ImagePath}"
                    Stretch="Uniform" />
            </Border>
            <StackPanel
                Grid.Column="1"
                Margin="0,14,16,14">
                <DockPanel LastChildFill="True">
                    <Border
                        DockPanel.Dock="Right"
                        Padding="8,2"
                        Margin="8,0,0,0"
                        Background="{DynamicResource SystemControlHighlightAccentBrush}"
                        Visibility="{Binding HasBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            FontSize="11"
                            Foreground="White"
                            Text="{Binding Badge}" />
                    </Border>
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock
                    Margin="0,6,0,0"
                    MaxHeight="58"
                    Opacity="0.72"
                    Text="{Binding Subtitle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
