<UserControl
    x:Class="ModernWpf.SampleApp.Controls.CounterBadgeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ModernWpf.SampleApp.Controls">
    <Border
        Padding="18"
        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
        <StackPanel>
            <TextBlock
                FontSize="18"
                FontWeight="SemiBold"
                Text="{Binding Title, RelativeSource={RelativeSource AncestorType=local:CounterBadgeControl}}" />
            <TextBlock
                Margin="0,6,0,16"
                Opacity="0.72"
                Text="A reusable WPF UserControl with dependency properties and internal interaction." />
            <Button
                HorizontalAlignment="Left"
                Click="OnIncrementClick"
                Content="{Binding CountLabel, RelativeSource={RelativeSource AncestorType=local:CounterBadgeControl}}" />
        </StackPanel>
    </Border>
</UserControl>
