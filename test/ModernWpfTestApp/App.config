<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <runtime>
    <!-- Pen and touch input are irrelevant to this API suite. Disabling WPF's
         legacy stylus stack avoids test-host crashes caused by machine-specific
         tablet services while leaving product behavior unchanged. -->
    <AppContextSwitchOverrides value="Switch.System.Windows.Input.Stylus.DisableStylusAndTouchSupport=true" />
  </runtime>
</configuration>
