<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows7.0;net10.0-windows7.0</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ModernWpf.Controls\ModernWpf.Controls.csproj" />
    <ProjectReference Include="..\..\ModernWpf\ModernWpf.csproj" />
    <ProjectReference Include="..\ModernWpf.WinUI.TestInfra\ModernWpf.WinUI.TestInfra.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\ModernWpf\PublicResourceKeys.Shipped.txt"
          Link="PublicResourceContract\PublicResourceKeys.Shipped.txt"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\ModernWpf\PublicResourceKeys.Unshipped.txt"
          Link="PublicResourceContract\PublicResourceKeys.Unshipped.txt"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\ModernWpf\DensityStyles\Compact.xaml"
          Link="PublicResourceContract\DensityStyles\Compact.xaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\ModernWpf\ModernWpfControlsResources.xaml"
          Link="PublicResourceContract\ModernWpfControlsResources.xaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\ModernWpf\ThemeResources\Dark.xaml"
          Link="PublicResourceContract\ThemeResources\Dark.xaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\ModernWpf\ThemeResources\HighContrast.xaml"
          Link="PublicResourceContract\ThemeResources\HighContrast.xaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\ModernWpf\ThemeResources\Light.xaml"
          Link="PublicResourceContract\ThemeResources\Light.xaml"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
