<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <OfficialWpfGalleryOutput Condition="'$(OfficialWpfGalleryOutput)' == ''">D:\repos\WPF-Samples\Sample Applications\WPFGallery\bin\Debug\net10.0-windows</OfficialWpfGalleryOutput>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="WPFGallery">
      <HintPath>$(OfficialWpfGalleryOutput)\WPFGallery.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CommunityToolkit.Mvvm">
      <HintPath>$(OfficialWpfGalleryOutput)\CommunityToolkit.Mvvm.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
