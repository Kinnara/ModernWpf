<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ModernWpf.Controls">

    <Style TargetType="local:AnnotatedScrollBar">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:AnnotatedScrollBar">
                    <Grid>
                        <Border
                            x:Name="PART_Rail"
                            Width="2"
                            HorizontalAlignment="Right"
                            Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                        <ItemsControl
                            x:Name="PART_LabelsHost"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Stretch"
                            ItemTemplate="{TemplateBinding LabelTemplate}"
                            ItemsSource="{TemplateBinding Labels}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
