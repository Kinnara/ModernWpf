<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:local="clr-namespace:ModernWpf.Controls"
    xmlns:m="clr-namespace:ModernWpf.Markup;assembly=ModernWpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ModernWpf;component/Styles/Button.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <m:StaticResource x:Key="PagerControlSelectionIndicatorForeground" ResourceKey="AccentFillColorDefaultBrush" />
    <m:StaticResource x:Key="PagerControlPageNavigationButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
    <m:StaticResource x:Key="PagerControlPageNavigationButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
    <m:StaticResource x:Key="PagerControlPageNavigationButtonBackgroundDisabled" ResourceKey="SubtleFillColorDisabledBrush" />
    <m:StaticResource x:Key="PagerControlPageNavigationButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
    <m:StaticResource x:Key="PagerControlPageNavigationButtonForegroundPressed" ResourceKey="TextFillColorPrimaryBrush" />
    <m:StaticResource x:Key="PagerControlPageNavigationButtonForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />
    <sys:Double x:Key="PagerControlNumberPanelButtonWidth">32</sys:Double>

    <Style x:Key="PagerControlPageNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
        <Setter Property="ui:ControlHelper.CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <Style x:Key="PagerControlNumberPanelButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinWidth" Value="{StaticResource PagerControlNumberPanelButtonWidth}" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="ui:ControlHelper.CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <Style TargetType="local:PagerControl">
        <Setter Property="FirstButtonStyle" Value="{StaticResource PagerControlPageNavigationButtonStyle}" />
        <Setter Property="PreviousButtonStyle" Value="{StaticResource PagerControlPageNavigationButtonStyle}" />
        <Setter Property="NextButtonStyle" Value="{StaticResource PagerControlPageNavigationButtonStyle}" />
        <Setter Property="LastButtonStyle" Value="{StaticResource PagerControlPageNavigationButtonStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PagerControl">
                    <ui:GridEx
                        x:Name="RootGrid"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <VisualStateManager.CustomVisualStateManager>
                            <ui:VisualStateManagerEx />
                        </VisualStateManager.CustomVisualStateManager>
                        <ui:GridEx.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </ui:GridEx.RowDefinitions>
                        <ui:GridEx.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </ui:GridEx.ColumnDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="FirstPageButtonVisibilityStates">
                                <VisualState x:Name="FirstPageButtonVisible" />
                                <ui:VisualStateEx x:Name="FirstPageButtonCollapsed">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="FirstPageButton.Visibility" Value="Collapsed" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="FirstPageButtonHidden">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="FirstPageButton.Opacity" Value="0" />
                                        <ui:VisualStateSetter Target="FirstPageButton.IsEnabled" Value="False" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FirstPageButtonIsEnabledStates">
                                <VisualState x:Name="FirstPageButtonEnabled" />
                                <ui:VisualStateEx x:Name="FirstPageButtonDisabled">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="FirstPageButton.IsEnabled" Value="False" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="PreviousPageButtonVisibilityStates">
                                <VisualState x:Name="PreviousPageButtonVisible" />
                                <ui:VisualStateEx x:Name="PreviousPageButtonCollapsed">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="PreviousPageButton.Visibility" Value="Collapsed" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="PreviousPageButtonHidden">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="PreviousPageButton.Opacity" Value="0" />
                                        <ui:VisualStateSetter Target="PreviousPageButton.IsEnabled" Value="False" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="PreviousPageButtonIsEnabledStates">
                                <VisualState x:Name="PreviousPageButtonEnabled" />
                                <ui:VisualStateEx x:Name="PreviousPageButtonDisabled">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="PreviousPageButton.IsEnabled" Value="False" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="NextPageButtonVisibilityStates">
                                <VisualState x:Name="NextPageButtonVisible" />
                                <ui:VisualStateEx x:Name="NextPageButtonCollapsed">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="NextPageButton.Visibility" Value="Collapsed" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="NextPageButtonIsEnabledStates">
                                <VisualState x:Name="NextPageButtonEnabled" />
                                <ui:VisualStateEx x:Name="NextPageButtonDisabled">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="NextPageButton.IsEnabled" Value="False" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="NextPageButtonHidden">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="NextPageButton.Opacity" Value="0" />
                                        <ui:VisualStateSetter Target="NextPageButton.IsEnabled" Value="False" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="LastPageButtonStates">
                                <VisualState x:Name="LastPageButtonVisible" />
                                <ui:VisualStateEx x:Name="LastPageButtonCollapsed">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="LastPageButton.Visibility" Value="Collapsed" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>
                            <VisualStateGroup>
                                <VisualState x:Name="LastPageButtonEnabled" />
                                <ui:VisualStateEx x:Name="LastPageButtonDisabled">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="LastPageButton.IsEnabled" Value="False" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="LastPageButtonHidden">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="LastPageButton.Opacity" Value="0" />
                                        <ui:VisualStateSetter Target="LastPageButton.IsEnabled" Value="False" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="PagerDisplayModeStates">
                                <ui:VisualStateEx x:Name="NumberBoxVisible">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="BoxPanels.Visibility" Value="Visible" />
                                        <ui:VisualStateSetter Target="NumberBoxDisplay.Visibility" Value="Visible" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="ComboBoxVisible">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="ComboBoxDisplay.IsEnabled" Value="True" />
                                        <ui:VisualStateSetter Target="BoxPanels.Visibility" Value="Visible" />
                                        <ui:VisualStateSetter Target="ComboBoxDisplay.Visibility" Value="Visible" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="NumberPanelVisible">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="BoxPanels.Visibility" Value="Collapsed" />
                                        <ui:VisualStateSetter Target="NumberBoxDisplay.Visibility" Value="Collapsed" />
                                        <ui:VisualStateSetter Target="ComboBoxDisplay.Visibility" Value="Collapsed" />
                                        <ui:VisualStateSetter Target="NumberPanelItemsRepeater.Visibility" Value="Visible" />
                                        <ui:VisualStateSetter Target="NumberPanelCurrentPageIndicator.Visibility" Value="Visible" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="InfiniteItemsDisplayMode">
                                <VisualState x:Name="FiniteItems" />
                                <ui:VisualStateEx x:Name="InfiniteItems">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="SuffixTextLabel.Visibility" Value="Collapsed" />
                                        <ui:VisualStateSetter Target="TotalNumberOfPagesLabel.Visibility" Value="Collapsed" />
                                        <ui:VisualStateSetter Target="LastPageButton.Visibility" Value="Collapsed" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="FirstPageButton"
                                ToolTip="{Binding ElementName=FirstPageButton, Path=(AutomationProperties.Name)}"
                                Style="{TemplateBinding FirstButtonStyle}"
                                Content="&#xE892;" />
                            <Button x:Name="PreviousPageButton"
                                ToolTip="{Binding ElementName=PreviousPageButton, Path=(AutomationProperties.Name)}"
                                Style="{TemplateBinding PreviousButtonStyle}"
                                Content="&#xE76B;" />
                        </StackPanel>
                        <StackPanel x:Name="BoxPanels" Visibility="Collapsed" Orientation="Horizontal" Grid.Column="1">
                            <TextBlock Text="{TemplateBinding PrefixText}" VerticalAlignment="Center" Margin="5,0,5,0" />
                            <local:NumberBox x:Name="NumberBoxDisplay"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Maximum="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=NumberOfPages, Mode=OneWay}"
                                Minimum="1"
                                SmallChange="1"
                                LargeChange="5"
                                Visibility="Collapsed" />
                            <ComboBox x:Name="ComboBoxDisplay"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.Pages}"
                                Visibility="Collapsed" />
                            <TextBlock x:Name="SuffixTextLabel" Text="{TemplateBinding SuffixText}" VerticalAlignment="Center" Margin="5,0,0,0" />
                            <TextBlock x:Name="TotalNumberOfPagesLabel"
                                VerticalAlignment="Center"
                                Margin="5,0,5,0"
                                Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=NumberOfPages, Mode=OneWay}" />
                        </StackPanel>
                        <local:ItemsRepeater x:Name="NumberPanelItemsRepeater"
                            ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.NumberPanelItems}"
                            Grid.Column="1"
                            Visibility="Collapsed">
                            <local:ItemsRepeater.Layout>
                                <local:StackLayout Orientation="Horizontal" Spacing="5" />
                            </local:ItemsRepeater.Layout>
                        </local:ItemsRepeater>
                        <Rectangle x:Name="NumberPanelCurrentPageIndicator"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Grid.Column="1"
                            Visibility="Collapsed"
                            Fill="{DynamicResource PagerControlSelectionIndicatorForeground}"
                            RadiusX="1"
                            RadiusY="1"
                            Height="2" />
                        <StackPanel Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Left">
                            <Button x:Name="NextPageButton"
                                ToolTip="{Binding ElementName=NextPageButton, Path=(AutomationProperties.Name)}"
                                Style="{TemplateBinding NextButtonStyle}"
                                Content="&#xE76C;" />
                            <Button x:Name="LastPageButton"
                                ToolTip="{Binding ElementName=LastPageButton, Path=(AutomationProperties.Name)}"
                                Style="{TemplateBinding LastButtonStyle}"
                                Content="&#xE893;" />
                        </StackPanel>
                    </ui:GridEx>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
