<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ModernWpf.Controls">

    <BooleanToVisibilityConverter x:Key="TabViewBooleanToVisibilityConverter" />

    <Style x:Key="DefaultTabViewButtonStyle" TargetType="ButtonBase">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource TabViewButtonBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TabViewButtonForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TabViewButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource TabViewButtonBorderThickness}" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource TabViewButtonBackgroundPointerOver}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource TabViewButtonBorderBrushPointerOver}" />
                            <Setter Property="Foreground" Value="{DynamicResource TabViewButtonForegroundPointerOver}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource TabViewButtonBackgroundPressed}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource TabViewButtonBorderBrushPressed}" />
                            <Setter Property="Foreground" Value="{DynamicResource TabViewButtonForegroundPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource TabViewButtonBackgroundDisabled}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource TabViewButtonBorderBrushDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource TabViewButtonForegroundDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultTabViewScrollButtonStyle" TargetType="RepeatButton">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource TabViewScrollButtonBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TabViewScrollButtonForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TabViewScrollButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource TabViewButtonBorderThickness}" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource TabViewScrollButtonBackgroundPointerOver}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource TabViewScrollButtonBorderBrushPointerOver}" />
                            <Setter Property="Foreground" Value="{DynamicResource TabViewScrollButtonForegroundPointerOver}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource TabViewScrollButtonBackgroundPressed}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource TabViewScrollButtonBorderBrushPressed}" />
                            <Setter Property="Foreground" Value="{DynamicResource TabViewScrollButtonForegroundPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource TabViewScrollButtonBackgroundDisabled}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource TabViewScrollButtonBorderBrushDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource TabViewScrollButtonForegroundDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultTabViewCloseButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource TabViewItemHeaderCloseButtonBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TabViewItemHeaderCloseButtonForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TabViewItemHeaderCloseButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource TabViewItemHeaderCloseButtonBorderThickness}" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type local:TabViewItem}}}" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource TabViewItemHeaderPointerOverCloseButtonBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource TabViewItemHeaderPointerOverCloseButtonForeground}" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseCaptured, RelativeSource={RelativeSource AncestorType={x:Type local:TabViewItem}}}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type local:TabViewItem}}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource TabViewItemHeaderPressedCloseButtonBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource TabViewItemHeaderPressedCloseButtonForeground}" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type local:TabViewItem}}}" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource TabViewItemHeaderSelectedCloseButtonBackground}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource TabViewItemHeaderCloseButtonBorderBrushSelected}" />
                            <Setter Property="Foreground" Value="{DynamicResource TabViewItemHeaderSelectedCloseButtonForeground}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource TabViewItemHeaderCloseButtonBackgroundPointerOver}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource TabViewItemHeaderCloseButtonBorderBrushPointerOver}" />
                            <Setter Property="Foreground" Value="{DynamicResource TabViewItemHeaderCloseButtonForegroundPointerOver}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource TabViewItemHeaderCloseButtonBackgroundPressed}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource TabViewItemHeaderCloseButtonBorderBrushPressed}" />
                            <Setter Property="Foreground" Value="{DynamicResource TabViewItemHeaderCloseButtonForegroundPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource TabViewItemHeaderDisabledCloseButtonBackground}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource TabViewItemHeaderCloseButtonBorderBrushDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource TabViewItemHeaderDisabledCloseButtonForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:TabViewItem">
        <Setter Property="MinWidth" Value="{DynamicResource TabViewItemMinWidth}" />
        <Setter Property="MinHeight" Value="{DynamicResource TabViewItemMinHeight}" />
        <Setter Property="MaxWidth" Value="{DynamicResource TabViewItemMaxWidth}" />
        <Setter Property="FontSize" Value="{DynamicResource TabViewItemHeaderFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TabViewItemHeaderForeground}" />
        <Setter Property="Background" Value="{DynamicResource TabViewItemHeaderBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TabViewItemBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource TabViewItemBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource TabViewItemHeaderPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TabViewItem">
                    <Grid x:Name="Root" Background="Transparent">
                        <Border
                            x:Name="PART_GeometryCornerRadiusProbe"
                            CornerRadius="{DynamicResource OverlayCornerRadius}"
                            Visibility="Collapsed" />
                        <Canvas IsHitTestVisible="False">
                            <Path
                                x:Name="SelectedBackgroundPath"
                                Canvas.Left="-4"
                                Data="{Binding TabViewTemplateSettings.TabGeometry, RelativeSource={RelativeSource TemplatedParent}}"
                                Fill="{DynamicResource TabViewItemHeaderBackgroundSelected}"
                                Visibility="Collapsed" />
                        </Canvas>
                        <Border
                            x:Name="HeaderBackground"
                            Margin="0,0,0,1"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4,4,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter
                                    x:Name="IconPresenter"
                                    Width="{DynamicResource TabViewItemHeaderIconSize}"
                                    Height="{DynamicResource TabViewItemHeaderIconSize}"
                                    Margin="{DynamicResource TabViewItemHeaderIconMargin}"
                                    VerticalAlignment="Center"
                                    Content="{Binding TabViewTemplateSettings.IconElement, RelativeSource={RelativeSource TemplatedParent}}"
                                    TextElement.Foreground="{DynamicResource TabViewItemIconForeground}" />
                                <ContentPresenter
                                    x:Name="HeaderPresenter"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    RecognizesAccessKey="True"
                                    TextElement.Foreground="{TemplateBinding Foreground}" />
                                <Button
                                    x:Name="PART_CloseButton"
                                    Grid.Column="2"
                                    Width="{DynamicResource TabViewItemHeaderCloseButtonWidth}"
                                    Height="{DynamicResource TabViewItemHeaderCloseButtonHeight}"
                                    Margin="{DynamicResource TabViewItemHeaderCloseMargin}"
                                    Content="&#xE711;"
                                    FontSize="{DynamicResource TabViewItemHeaderCloseFontSize}"
                                    Focusable="True"
                                    IsTabStop="False"
                                    Style="{StaticResource DefaultTabViewCloseButtonStyle}" />
                            </Grid>
                        </Border>
                        <Border
                            x:Name="TabSeparator"
                            Width="1"
                            Margin="{DynamicResource TabViewItemSeparatorMargin}"
                            HorizontalAlignment="Right"
                            Background="{DynamicResource TabViewItemSeparator}"
                            IsHitTestVisible="False" />
                        <Border
                            x:Name="PART_DragVisual"
                            Margin="0,0,0,1"
                            Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource TabViewItemHeaderDragBackground}"
                            BorderBrush="{DynamicResource TabViewBorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4,4,0,0"
                            IsHitTestVisible="False"
                            Opacity="0.86"
                            Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter
                                    Width="{DynamicResource TabViewItemHeaderIconSize}"
                                    Height="{DynamicResource TabViewItemHeaderIconSize}"
                                    Margin="{DynamicResource TabViewItemHeaderIconMargin}"
                                    VerticalAlignment="Center"
                                    Content="{Binding TabViewTemplateSettings.IconElement, RelativeSource={RelativeSource TemplatedParent}}"
                                    TextElement.Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter
                                    Grid.Column="1"
                                    MinWidth="0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <Border
                            x:Name="SelectedBorder"
                            Height="2"
                            Margin="8,0"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="1"
                            Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderBackground" Property="Background" Value="{DynamicResource TabViewItemHeaderBackgroundPointerOver}" />
                            <Setter TargetName="IconPresenter" Property="TextElement.Foreground" Value="{DynamicResource TabViewItemIconForegroundPointerOver}" />
                            <Setter TargetName="TabSeparator" Property="Opacity" Value="0" />
                            <Setter Property="Foreground" Value="{DynamicResource TabViewItemHeaderForegroundPointerOver}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseCaptured" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HeaderBackground" Property="Background" Value="{DynamicResource TabViewItemHeaderBackgroundPressed}" />
                            <Setter TargetName="IconPresenter" Property="TextElement.Foreground" Value="{DynamicResource TabViewItemIconForegroundPressed}" />
                            <Setter TargetName="TabSeparator" Property="Opacity" Value="0" />
                            <Setter Property="Foreground" Value="{DynamicResource TabViewItemHeaderForegroundPressed}" />
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectedBackgroundPath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderBackground" Property="Margin" Value="{DynamicResource TabViewSelectedItemHeaderMargin}" />
                            <Setter TargetName="HeaderBackground" Property="Padding" Value="{DynamicResource TabViewSelectedItemHeaderPadding}" />
                            <Setter TargetName="HeaderBackground" Property="BorderThickness" Value="{DynamicResource TabViewSelectedItemBorderThickness}" />
                            <Setter TargetName="HeaderBackground" Property="Background" Value="{DynamicResource TabViewItemHeaderBackground}" />
                            <Setter TargetName="HeaderBackground" Property="BorderBrush" Value="{DynamicResource TabViewSelectedItemBorderBrush}" />
                            <Setter TargetName="IconPresenter" Property="TextElement.Foreground" Value="{DynamicResource TabViewItemIconForegroundSelected}" />
                            <Setter TargetName="SelectedBorder" Property="Visibility" Value="Visible" />
                            <Setter TargetName="TabSeparator" Property="Opacity" Value="0" />
                            <Setter Property="Foreground" Value="{DynamicResource TabViewItemHeaderForegroundSelected}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="HeaderBackground" Property="Background" Value="{DynamicResource TabViewItemHeaderBackgroundDisabled}" />
                            <Setter TargetName="IconPresenter" Property="TextElement.Foreground" Value="{DynamicResource TabViewItemIconForegroundDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource TabViewItemHeaderForegroundDisabled}" />
                        </Trigger>
                        <Trigger Property="IsClosable" Value="False">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_CloseButton" Property="IsTabStop" Value="False" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CloseButtonOverlayMode, RelativeSource={RelativeSource AncestorType={x:Type local:TabView}}}" Value="OnPointerOver" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="False" />
                                <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource TemplatedParent}}" Value="False" />
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_CloseButton" Property="IsTabStop" Value="False" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding TabWidthMode, RelativeSource={RelativeSource AncestorType={x:Type local:TabView}}}" Value="Compact" />
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IconPresenter" Property="Margin" Value="0" />
                            <Setter Property="MinWidth" Value="48" />
                        </MultiDataTrigger>
                        <Trigger SourceName="IconPresenter" Property="Content" Value="{x:Null}">
                            <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IconPresenter" Property="Margin" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:TabView">
        <Setter Property="Foreground" Value="{DynamicResource TabViewForeground}" />
        <Setter Property="Background" Value="{DynamicResource TabViewBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TabViewBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TabView">
                    <Grid Background="{TemplateBinding Background}" KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="TabStrip" Margin="{DynamicResource TabViewHeaderPadding}" Panel.ZIndex="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl
                                Content="{TemplateBinding TabStripHeader}"
                                ContentTemplate="{TemplateBinding TabStripHeaderTemplate}"
                                Focusable="False" />
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <RepeatButton
                                    x:Name="PART_ScrollDecreaseButton"
                                    Width="{DynamicResource TabViewItemScrollButtonWidth}"
                                    Height="{DynamicResource TabViewItemScrollButtonHeight}"
                                    Padding="{DynamicResource TabViewItemScrollButtonPadding}"
                                    Content="&#xE76B;"
                                    Delay="50"
                                    FontSize="{DynamicResource TabViewItemScrollButonFontSize}"
                                    Focusable="False"
                                    Interval="100"
                                    IsTabStop="False"
                                    Style="{StaticResource DefaultTabViewScrollButtonStyle}"
                                    Visibility="Collapsed" />
                                <ScrollViewer
                                    x:Name="PART_ScrollViewer"
                                    Grid.Column="1"
                                    CanContentScroll="False"
                                    HorizontalScrollBarVisibility="Hidden"
                                    PanningMode="HorizontalOnly"
                                    VerticalScrollBarVisibility="Disabled">
                                    <local:TabViewListView
                                        x:Name="PART_TabListView"
                                        AllowDrop="{TemplateBinding AllowDropTabs}"
                                        KeyboardNavigation.TabNavigation="Local">
                                        <local:TabViewListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </local:TabViewListView.ItemsPanel>
                                    </local:TabViewListView>
                                </ScrollViewer>
                                <RepeatButton
                                    x:Name="PART_ScrollIncreaseButton"
                                    Grid.Column="2"
                                    Width="{DynamicResource TabViewItemScrollButtonWidth}"
                                    Height="{DynamicResource TabViewItemScrollButtonHeight}"
                                    Padding="{DynamicResource TabViewItemScrollButtonPadding}"
                                    Content="&#xE76C;"
                                    Delay="50"
                                    FontSize="{DynamicResource TabViewItemScrollButonFontSize}"
                                    Focusable="False"
                                    Interval="100"
                                    IsTabStop="False"
                                    Style="{StaticResource DefaultTabViewScrollButtonStyle}"
                                    Visibility="Collapsed" />
                            </Grid>
                            <Button
                                x:Name="PART_AddButton"
                                Grid.Column="2"
                                Width="{DynamicResource TabViewItemAddButtonWidth}"
                                Height="{DynamicResource TabViewItemAddButtonHeight}"
                                Margin="{DynamicResource TabViewItemAddButtonContainerPadding}"
                                Command="{TemplateBinding AddTabButtonCommand}"
                                CommandParameter="{TemplateBinding AddTabButtonCommandParameter}"
                                Content="&#xE710;"
                                FontSize="{DynamicResource TabViewItemAddButtonFontSize}"
                                Style="{StaticResource DefaultTabViewButtonStyle}"
                                Visibility="{Binding IsAddTabButtonVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TabViewBooleanToVisibilityConverter}}" />
                            <ContentControl
                                Grid.Column="3"
                                Content="{TemplateBinding TabStripFooter}"
                                ContentTemplate="{TemplateBinding TabStripFooterTemplate}"
                                Focusable="False" />
                        </Grid>
                        <Border
                            Grid.Row="1"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter
                                x:Name="PART_TabContentPresenter"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
