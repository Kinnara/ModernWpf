<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:local="clr-namespace:ModernWpf.Controls"
    xmlns:m="clr-namespace:ModernWpf.Markup;assembly=ModernWpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <m:StaticResource x:Key="SelectorBarBackground" ResourceKey="SystemControlTransparentBrush" />
    <m:StaticResource x:Key="SelectorBarItemPillFill" ResourceKey="AccentFillColorDefaultBrush" />
    <m:StaticResource x:Key="SelectorBarItemDisabledPillFill" ResourceKey="AccentFillColorDisabledBrush" />
    <m:StaticResource x:Key="SelectorBarItemBorderBrush" ResourceKey="SystemControlTransparentBrush" />
    <m:StaticResource x:Key="SelectorBarItemBorderBrushPointerOver" ResourceKey="SystemControlTransparentBrush" />
    <m:StaticResource x:Key="SelectorBarItemBorderBrushSelected" ResourceKey="SystemControlTransparentBrush" />
    <m:StaticResource x:Key="SelectorBarItemBorderBrushPressed" ResourceKey="SystemControlTransparentBrush" />
    <m:StaticResource x:Key="SelectorBarItemBorderBrushDisabled" ResourceKey="SystemControlTransparentBrush" />
    <m:StaticResource x:Key="SelectorBarItemForeground" ResourceKey="TextFillColorPrimaryBrush" />
    <m:StaticResource x:Key="SelectorBarItemForegroundPointerOver" ResourceKey="TextFillColorSecondaryBrush" />
    <m:StaticResource x:Key="SelectorBarItemForegroundSelected" ResourceKey="TextFillColorPrimaryBrush" />
    <m:StaticResource x:Key="SelectorBarItemForegroundPressed" ResourceKey="TextFillColorTertiaryBrush" />
    <m:StaticResource x:Key="SelectorBarItemForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />
    <m:StaticResource x:Key="SelectorBarItemBackground" ResourceKey="SystemControlTransparentBrush" />
    <m:StaticResource x:Key="SelectorBarItemBackgroundPointerOver" ResourceKey="SystemControlTransparentBrush" />
    <m:StaticResource x:Key="SelectorBarItemBackgroundSelected" ResourceKey="SystemControlTransparentBrush" />
    <m:StaticResource x:Key="SelectorBarItemBackgroundPressed" ResourceKey="SystemControlTransparentBrush" />
    <m:StaticResource x:Key="SelectorBarItemBackgroundDisabled" ResourceKey="SystemControlTransparentBrush" />
    <Thickness x:Key="SelectorBarPadding">0,4</Thickness>
    <Thickness x:Key="SelectorBarBorderThickness">1</Thickness>
    <Thickness x:Key="SelectorBarItemBorderThickness">1</Thickness>
    <Thickness x:Key="SelectorBarSelectedInnerThickness">1</Thickness>
    <Thickness x:Key="SelectorBarItemIconVisualMargin">-2,0</Thickness>
    <Thickness x:Key="SelectorBarItemTextVisualMargin">0</Thickness>
    <Thickness x:Key="SelectorBarItemPadding">12,10,12,7</Thickness>
    <Thickness x:Key="SelectorBarItemSelectionVisualMargin">0</Thickness>
    <Thickness x:Key="SelectorBarItemFocusVisualMargin">-2</Thickness>
    <sys:Double x:Key="SelectorBarItemPillHeight">3</sys:Double>
    <sys:Double x:Key="SelectorBarItemPillWidth">4</sys:Double>
    <sys:Double x:Key="SelectorBarItemIconScale">0.8</sys:Double>
    <sys:Double x:Key="SelectorBarItemSpacing">8</sys:Double>

    <Style x:Key="SelectorBarItemPill" TargetType="Rectangle">
        <Setter Property="Fill" Value="{DynamicResource SelectorBarItemPillFill}" />
        <Setter Property="Height" Value="{StaticResource SelectorBarItemPillHeight}" />
        <Setter Property="Width" Value="{StaticResource SelectorBarItemPillWidth}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    </Style>

    <Style TargetType="local:SelectorBar">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Padding" Value="{StaticResource SelectorBarPadding}" />
        <Setter Property="Background" Value="{DynamicResource SelectorBarBackground}" />
        <Setter Property="BorderThickness" Value="{StaticResource SelectorBarBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SelectorBar">
                    <ui:GridEx
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            Focusable="False">
                            <local:SelectorBarItemsControl
                                x:Name="PART_ItemsView"
                                ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Items}"
                                MaxWidth="{TemplateBinding MaxWidth}"
                                MaxHeight="{TemplateBinding MaxHeight}"
                                Padding="{TemplateBinding Padding}"
                                KeyboardNavigation.TabNavigation="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(KeyboardNavigation.TabNavigation)}">
                                <local:SelectorBarItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </local:SelectorBarItemsControl.ItemsPanel>
                            </local:SelectorBarItemsControl>
                        </ScrollViewer>
                    </ui:GridEx>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:SelectorBarItem">
        <Setter Property="BackgroundSizing" Value="OuterBorderEdge" />
        <Setter Property="Foreground" Value="{DynamicResource SelectorBarItemForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SelectorBarItemBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource SelectorBarItemBorderThickness}" />
        <Setter Property="Padding" Value="{StaticResource SelectorBarItemPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualMargin" Value="{StaticResource SelectorBarItemFocusVisualMargin}" />
        <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
        <Setter Property="UseSystemFocusVisuals" Value="{DynamicResource UseSystemFocusVisuals}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SelectorBarItem">
                    <ui:GridEx
                        x:Name="PART_ContainerRoot"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BackgroundSizing="{TemplateBinding BackgroundSizing}">
                        <ui:GridEx.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </ui:GridEx.RowDefinitions>
                        <ui:GridEx.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </ui:GridEx.ColumnDefinitions>

                        <VisualStateManager.CustomVisualStateManager>
                            <ui:VisualStateManagerEx />
                        </VisualStateManager.CustomVisualStateManager>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CombinedStates">
                                <VisualState x:Name="UnselectedNormal" />
                                <ui:VisualStateEx x:Name="UnselectedPointerOver">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="PART_ContainerRoot.Background" Value="{DynamicResource SelectorBarItemBackgroundPointerOver}" />
                                        <ui:VisualStateSetter Target="PART_TextVisual.Foreground" Value="{DynamicResource SelectorBarItemForegroundPointerOver}" />
                                        <ui:VisualStateSetter Target="PART_IconVisual.Foreground" Value="{DynamicResource SelectorBarItemForegroundPointerOver}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="UnselectedPressed">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="PART_ContainerRoot.Background" Value="{DynamicResource SelectorBarItemBackgroundPressed}" />
                                        <ui:VisualStateSetter Target="PART_TextVisual.Foreground" Value="{DynamicResource SelectorBarItemForegroundPressed}" />
                                        <ui:VisualStateSetter Target="PART_IconVisual.Foreground" Value="{DynamicResource SelectorBarItemForegroundPressed}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="SelectedNormal">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="PART_ContainerRoot.Background" Value="{DynamicResource SelectorBarItemBackgroundSelected}" />
                                        <ui:VisualStateSetter Target="PART_TextVisual.Foreground" Value="{DynamicResource SelectorBarItemForegroundSelected}" />
                                        <ui:VisualStateSetter Target="PART_IconVisual.Foreground" Value="{DynamicResource SelectorBarItemForegroundSelected}" />
                                        <ui:VisualStateSetter Target="PillTransform.ScaleX" Value="4" />
                                        <ui:VisualStateSetter Target="PART_SelectionVisual.Opacity" Value="1" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="SelectedPointerOver">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="PART_TextVisual.Foreground" Value="{DynamicResource SelectorBarItemForegroundPointerOver}" />
                                        <ui:VisualStateSetter Target="PART_IconVisual.Foreground" Value="{DynamicResource SelectorBarItemForegroundPointerOver}" />
                                        <ui:VisualStateSetter Target="PillTransform.ScaleX" Value="4" />
                                        <ui:VisualStateSetter Target="PART_SelectionVisual.Opacity" Value="1" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="SelectedPressed">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="PART_TextVisual.Foreground" Value="{DynamicResource SelectorBarItemForegroundPointerOver}" />
                                        <ui:VisualStateSetter Target="PART_IconVisual.Foreground" Value="{DynamicResource SelectorBarItemForegroundPointerOver}" />
                                        <ui:VisualStateSetter Target="PillTransform.ScaleX" Value="4" />
                                        <ui:VisualStateSetter Target="PART_SelectionVisual.Opacity" Value="1" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="DisabledStates">
                                <VisualState x:Name="Enabled" />
                                <ui:VisualStateEx x:Name="Disabled">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="PART_ContainerRoot.Background" Value="{DynamicResource SelectorBarItemBackgroundDisabled}" />
                                        <ui:VisualStateSetter Target="PART_IconVisual.Foreground" Value="{DynamicResource SelectorBarItemForegroundDisabled}" />
                                        <ui:VisualStateSetter Target="PART_TextVisual.Foreground" Value="{DynamicResource SelectorBarItemForegroundDisabled}" />
                                        <ui:VisualStateSetter Target="PART_SelectionVisual.Fill" Value="{DynamicResource SelectorBarItemDisabledPillFill}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Rectangle
                            x:Name="PART_CommonVisual"
                            Grid.RowSpan="2"
                            Grid.ColumnSpan="2"
                            Fill="{DynamicResource SelectorBarItemBackground}"
                            Stroke="{DynamicResource SelectorBarItemBorderBrush}"
                            StrokeThickness="{Binding Source={StaticResource SelectorBarSelectedInnerThickness}, Path=Left}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            IsHitTestVisible="False"
                            RadiusX="{Binding CornerRadius.TopLeft, RelativeSource={RelativeSource TemplatedParent}}"
                            RadiusY="{Binding CornerRadius.BottomRight, RelativeSource={RelativeSource TemplatedParent}}" />

                        <ui:StackPanelEx
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="{TemplateBinding Padding}"
                            Spacing="{StaticResource SelectorBarItemSpacing}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <ui:ContentPresenterEx
                                x:Name="PART_IconVisual"
                                Content="{TemplateBinding Icon}"
                                Margin="{StaticResource SelectorBarItemIconVisualMargin}"
                                Foreground="{TemplateBinding Foreground}"
                                RenderTransformOrigin="0.5,0.5">
                                <ui:ContentPresenterEx.RenderTransform>
                                    <ScaleTransform
                                        ScaleX="{StaticResource SelectorBarItemIconScale}"
                                        ScaleY="{StaticResource SelectorBarItemIconScale}" />
                                </ui:ContentPresenterEx.RenderTransform>
                            </ui:ContentPresenterEx>
                            <TextBlock
                                x:Name="PART_TextVisual"
                                Text="{TemplateBinding Text}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontWeight="{TemplateBinding FontWeight}"
                                FontSize="{TemplateBinding FontSize}"
                                Margin="{StaticResource SelectorBarItemTextVisualMargin}"
                                Foreground="{TemplateBinding Foreground}"
                                TextWrapping="Wrap" />
                        </ui:StackPanelEx>

                        <Rectangle
                            x:Name="PART_SelectionVisual"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource SelectorBarItemPill}"
                            RadiusX="0.5"
                            RadiusY="1"
                            Margin="{StaticResource SelectorBarItemSelectionVisualMargin}"
                            VerticalAlignment="Bottom"
                            IsHitTestVisible="False"
                            Opacity="0">
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="PillTransform" ScaleX="1" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </ui:GridEx>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Background" Value="{DynamicResource SelectorBarItemBackground}" />
    </Style>
</ResourceDictionary>
