<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ModernWpf.Controls"
    xmlns:ui="http://schemas.modernwpf.com/2019">

    <Style TargetType="local:SwipeControl">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="{DynamicResource ListViewItemMinHeight}" />
        <Setter Property="MinWidth" Value="{DynamicResource ListViewItemMinWidth}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SwipeControl">
                    <Grid
                        x:Name="PART_Root"
                        Background="Transparent"
                        ClipToBounds="True">
                        <Grid x:Name="PART_ItemsRoot">
                            <StackPanel
                                x:Name="PART_TopItemsPanel"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Orientation="Horizontal"
                                Visibility="Collapsed" />
                            <StackPanel
                                x:Name="PART_LeftItemsPanel"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Orientation="Horizontal"
                                Visibility="Collapsed" />
                            <StackPanel
                                x:Name="PART_RightItemsPanel"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Stretch"
                                Orientation="Horizontal"
                                Visibility="Collapsed" />
                            <StackPanel
                                x:Name="PART_BottomItemsPanel"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal"
                                Visibility="Collapsed" />
                        </Grid>

                        <ui:ContentPresenterEx
                            x:Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">
                            <ui:ContentPresenterEx.RenderTransform>
                                <TranslateTransform x:Name="PART_ContentTransform" />
                            </ui:ContentPresenterEx.RenderTransform>
                        </ui:ContentPresenterEx>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
