<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ModernWpf.Controls"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:m="clr-namespace:ModernWpf.Markup;assembly=ModernWpf">

    <Style x:Key="DefaultSwipeItemStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="MinWidth" Value="68" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Background" Value="{DynamicResource SwipeItemBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource SwipeItemForeground}" />
        <Setter Property="Padding" Value="8,4,8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Root"
                        MinWidth="{TemplateBinding MinWidth}"
                        MinHeight="{TemplateBinding MinHeight}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <VisualStateManager.CustomVisualStateManager>
                            <ui:VisualStateManagerEx />
                        </VisualStateManager.CustomVisualStateManager>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <ui:VisualStateEx x:Name="Normal" />
                                <ui:VisualStateEx x:Name="Disabled" />
                                <ui:VisualStateEx x:Name="PointerOver" />
                                <ui:VisualStateEx x:Name="Pressed">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="Root.Background" Value="{DynamicResource SwipeItemBackgroundPressed}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:SwipeControl">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="{DynamicResource ListViewItemMinHeight}" />
        <Setter Property="MinWidth" Value="{DynamicResource ListViewItemMinWidth}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SwipeControl">
                    <Grid
                        x:Name="PART_Root"
                        Background="Transparent"
                        ClipToBounds="True">
                        <Grid.Resources>
                            <m:StaticResource x:Key="SwipeItemBackground" ResourceKey="ControlFillColorTertiaryBrush" />
                            <m:StaticResource x:Key="SwipeItemForeground" ResourceKey="TextFillColorPrimaryBrush" />
                            <m:StaticResource x:Key="SwipeItemBackgroundPressed" ResourceKey="ControlAltFillColorQuarternaryBrush" />
                            <Style x:Key="SwipeItemStyle" TargetType="Button" BasedOn="{StaticResource DefaultSwipeItemStyle}" />
                        </Grid.Resources>
                        <Grid x:Name="PART_ItemsRoot">
                            <StackPanel
                                x:Name="PART_TopItemsPanel"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Orientation="Horizontal"
                                Visibility="Collapsed" />
                            <StackPanel
                                x:Name="PART_LeftItemsPanel"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Orientation="Horizontal"
                                Visibility="Collapsed" />
                            <StackPanel
                                x:Name="PART_RightItemsPanel"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Stretch"
                                Orientation="Horizontal"
                                Visibility="Collapsed" />
                            <StackPanel
                                x:Name="PART_BottomItemsPanel"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal"
                                Visibility="Collapsed" />
                        </Grid>

                        <ui:ContentPresenterEx
                            x:Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">
                            <ui:ContentPresenterEx.RenderTransform>
                                <TranslateTransform x:Name="PART_ContentTransform" />
                            </ui:ContentPresenterEx.RenderTransform>
                        </ui:ContentPresenterEx>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
