<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:local="clr-namespace:ModernWpf.Controls"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Double x:Key="PipsPagerHorizontalOrientationButtonWidth">12</sys:Double>
    <sys:Double x:Key="PipsPagerHorizontalOrientationButtonHeight">20</sys:Double>
    <sys:Double x:Key="PipsPagerVerticalOrientationButtonWidth">20</sys:Double>
    <sys:Double x:Key="PipsPagerVerticalOrientationButtonHeight">12</sys:Double>

    <Style x:Key="DefaultPipsPagerNavigationButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
    </Style>

    <Style x:Key="DefaultPipsPagerPipButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="RootGrid"
                        Width="{StaticResource PipsPagerHorizontalOrientationButtonWidth}"
                        Height="{StaticResource PipsPagerHorizontalOrientationButtonHeight}"
                        Background="{TemplateBinding Background}">
                        <VisualStateManager.CustomVisualStateManager>
                            <ui:VisualStateManagerEx />
                        </VisualStateManager.CustomVisualStateManager>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="OrientationStates">
                                <ui:VisualStateEx x:Name="HorizontalOrientation" />
                                <ui:VisualStateEx x:Name="VerticalOrientation">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="RootGrid.Width" Value="{StaticResource PipsPagerVerticalOrientationButtonWidth}" />
                                        <ui:VisualStateSetter Target="RootGrid.Height" Value="{StaticResource PipsPagerVerticalOrientationButtonHeight}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultPipsPagerSelectedPipButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultPipsPagerPipButtonStyle}">
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style TargetType="local:PipsPager">
        <Setter Property="SelectedPipStyle" Value="{StaticResource DefaultPipsPagerSelectedPipButtonStyle}" />
        <Setter Property="NormalPipStyle" Value="{StaticResource DefaultPipsPagerPipButtonStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PipsPager">
                    <StackPanel
                        x:Name="PART_RootPanel"
                        Orientation="{TemplateBinding Orientation}">
                        <VisualStateManager.CustomVisualStateManager>
                            <ui:VisualStateManagerEx />
                        </VisualStateManager.CustomVisualStateManager>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="PreviousPageButtonVisibilityStates">
                                <ui:VisualStateEx x:Name="PreviousPageButtonVisible" />
                                <ui:VisualStateEx x:Name="PreviousPageButtonHidden">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="PART_PreviousButton.Opacity" Value="0" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="PreviousPageButtonCollapsed">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="PART_PreviousButton.Visibility" Value="Collapsed" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="PreviousPageButtonIsEnabledStates">
                                <ui:VisualStateEx x:Name="PreviousPageButtonEnabled" />
                                <ui:VisualStateEx x:Name="PreviousPageButtonDisabled">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="PART_PreviousButton.IsEnabled" Value="False" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="NextPageButtonVisibilityStates">
                                <ui:VisualStateEx x:Name="NextPageButtonVisible" />
                                <ui:VisualStateEx x:Name="NextPageButtonHidden">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="PART_NextButton.Opacity" Value="0" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="NextPageButtonCollapsed">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="PART_NextButton.Visibility" Value="Collapsed" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="NextPageButtonIsEnabledStates">
                                <ui:VisualStateEx x:Name="NextPageButtonEnabled" />
                                <ui:VisualStateEx x:Name="NextPageButtonDisabled">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="PART_NextButton.IsEnabled" Value="False" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="RootPanelOrientationStates">
                                <ui:VisualStateEx x:Name="VerticalOrientationView" />
                                <ui:VisualStateEx x:Name="HorizontalOrientationView">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="PART_RootPanel.Orientation" Value="Horizontal" />
                                        <ui:VisualStateSetter Target="PART_PreviousButton.(ToolTipService.Placement)" Value="Left" />
                                        <ui:VisualStateSetter Target="PART_PreviousButton.RenderTransformOrigin" Value="0.5,0.5" />
                                        <ui:VisualStateSetter Target="PART_PreviousButton.RenderTransform">
                                            <ui:VisualStateSetter.Value>
                                                <RotateTransform Angle="-90" />
                                            </ui:VisualStateSetter.Value>
                                        </ui:VisualStateSetter>
                                        <ui:VisualStateSetter Target="PART_NextButton.(ToolTipService.Placement)" Value="Right" />
                                        <ui:VisualStateSetter Target="PART_NextButton.RenderTransformOrigin" Value="0.5,0.5" />
                                        <ui:VisualStateSetter Target="PART_NextButton.RenderTransform">
                                            <ui:VisualStateSetter.Value>
                                                <RotateTransform Angle="-90" />
                                            </ui:VisualStateSetter.Value>
                                        </ui:VisualStateSetter>
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Button
                            x:Name="PART_PreviousButton"
                            Content="&#xEDDB;"
                            Style="{StaticResource DefaultPipsPagerNavigationButtonStyle}"
                            ToolTipService.Placement="Top"
                            AutomationProperties.Name="Previous page" />
                        <StackPanel x:Name="PART_PipsPanel" Orientation="{TemplateBinding Orientation}" />
                        <Button
                            x:Name="PART_NextButton"
                            Content="&#xEDDC;"
                            Style="{StaticResource DefaultPipsPagerNavigationButtonStyle}"
                            ToolTipService.Placement="Bottom"
                            AutomationProperties.Name="Next page" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
