<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:local="clr-namespace:ModernWpf.Controls">

    <Style TargetType="local:RatingControl">
        <Setter Property="MinHeight" Value="32" />
        <!-- 9794813: retire these two properties as customisation points once all resource keys available -->
        <Setter Property="Foreground" Value="{DynamicResource RatingControlCaptionForeground}" />
        <Setter Property="UseSystemFocusVisuals" Value="{DynamicResource UseSystemFocusVisuals}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource {x:Static SystemParameters.FocusVisualStyleKey}}" />
        <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
        <Setter Property="ItemInfo" Value="{DynamicResource MUX_RatingControlDefaultFontInfo}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RatingControl">
                    <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}">
                        <VisualStateManager.CustomVisualStateManager>
                            <ui:VisualStateManagerEx />
                        </VisualStateManager.CustomVisualStateManager>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <ui:VisualStateEx x:Name="Disabled">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="ForegroundContentPresenter.Foreground" Value="{DynamicResource RatingControlDisabledSelectedForeground}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="Placeholder">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="ForegroundContentPresenter.Foreground" Value="{DynamicResource RatingControlPlaceholderForeground}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="PointerOverPlaceholder">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="ForegroundContentPresenter.Foreground" Value="{DynamicResource RatingControlPointerOverPlaceholderForeground}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="PointerOverUnselected">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="ForegroundContentPresenter.Foreground" Value="{DynamicResource RatingControlPointerOverUnselectedForeground}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="Set">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="ForegroundContentPresenter.Foreground" Value="{DynamicResource RatingControlSelectedForeground}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="PointerOverSet">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="ForegroundContentPresenter.Foreground" Value="{DynamicResource RatingControlSelectedForeground}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <StackPanel
                            x:Name="CaptionStackPanel"
                            Orientation="Horizontal"
                            Grid.Row="0"
                            Margin="-20,-20,-20,-20">
                            <ui:StackPanelEx
                                x:Name="RatingBackgroundStackPanel"
                                Orientation="Horizontal"
                                Background="Transparent"
                                Margin="20,20,0,20">
                                <ui:StackPanelEx.RenderTransform>
                                    <TranslateTransform x:Name="RatingBackgroundStackPanelTranslateTransform" />
                                </ui:StackPanelEx.RenderTransform>
                            </ui:StackPanelEx>
                            <TextBlock x:Name="Caption" Margin="4,0,20,0" Style="{DynamicResource CaptionTextBlockStyle}"
                                FontFamily="{DynamicResource ContentControlThemeFontFamily}" FontSize="12" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" IsHitTestVisible="False"
                                AutomationProperties.Name="RatingCaption" Text="{TemplateBinding Caption}"/>
                            <!-- 4 = 8 item spacing +4 of magic redline spacing -8 to compensate for scale of the last RatingItem -->
                            <!--
                                NB: The redlines say 8px, but it's really 12 px because:
                                Designer note: The value between the last glyph and first text character is 12px.
                                (There's 4px of whitespace accounted for in the text area in the redline)
                            -->
                            <!-- TODO MSFT: 9925444 Fix vertical alignment in all text scenarios -->
                        </StackPanel>

                        <ui:ContentPresenterEx
                            x:Name="ForegroundContentPresenter"
                            IsHitTestVisible="False"
                            Grid.Row="0">
                            <!-- Margin is on the StackPanel because ContentPresenter clips differently such that moving the reverse margin up won't work -->
                            <ui:ContentPresenterEx.Content>
                                <StackPanel
                                    Orientation="Horizontal"
                                    Margin="-40,-40,-40,-40">
                                    <ui:StackPanelEx
                                        x:Name="RatingForegroundStackPanel"
                                        Orientation="Horizontal"
                                        IsHitTestVisible="False"
                                        Margin="40,40,40,40">
                                        <ui:StackPanelEx.RenderTransform>
                                            <TranslateTransform x:Name="RatingForegroundStackPanelTranslateTransform" />
                                        </ui:StackPanelEx.RenderTransform>
                                    </ui:StackPanelEx>
                                </StackPanel>
                            </ui:ContentPresenterEx.Content>
                        </ui:ContentPresenterEx>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
