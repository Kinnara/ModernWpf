<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ModernWpf.Controls"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:m="clr-namespace:ModernWpf.Markup;assembly=ModernWpf">

    <sys:Double x:Key="TeachingTipMinHeight">40</sys:Double>
    <sys:Double x:Key="TeachingTipMaxHeight">520</sys:Double>
    <sys:Double x:Key="TeachingTipMinWidth">320</sys:Double>
    <sys:Double x:Key="TeachingTipMaxWidth">336</sys:Double>

    <Thickness x:Key="TeachingTipButtonPanelMargin">0,12,0,0</Thickness>
    <Thickness x:Key="TeachingTipRightButtonMargin">4,12,0,0</Thickness>
    <Thickness x:Key="TeachingTipLeftButtonMargin">0,12,4,0</Thickness>
    <Thickness x:Key="TeachingTipMainContentPresentMargin">0,12,0,0</Thickness>
    <Thickness x:Key="TeachingTipMainContentAbsentMargin">0,0,0,0</Thickness>
    <Thickness x:Key="TeachingTipTitleStackPanelMarginWithHeaderCloseButton">0,0,28,0</Thickness>
    <Thickness x:Key="TeachingTipTitleStackPanelMarginWithFooterCloseButton">0,0,0,0</Thickness>
    <Thickness x:Key="TeachingTipIconPresenterMarginWithIcon">0,0,12,0</Thickness>
    <Thickness x:Key="TeachingTipIconPresenterMarginWithoutIcon">0,0,0,0</Thickness>
    <Thickness x:Key="TeachingTipContentBorderThicknessTop">1,1,1,0</Thickness>
    <Thickness x:Key="TeachingTipContentBorderThicknessBottom">1,0,1,1</Thickness>
    <Thickness x:Key="TeachingTipContentBorderThicknessLeft">1,1,0,1</Thickness>
    <Thickness x:Key="TeachingTipContentBorderThicknessRight">0,1,1,1</Thickness>
    <Thickness x:Key="TeachingTipContentBorderThicknessUntargeted">1,1,1,1</Thickness>
    <Thickness x:Key="TeachingTipTailPolygonMarginTop">0,-1,0,0</Thickness>
    <Thickness x:Key="TeachingTipTailPolygonMarginBottom">0,0,0,-1</Thickness>
    <Thickness x:Key="TeachingTipTailPolygonMarginLeft">-1,0,0,0</Thickness>
    <Thickness x:Key="TeachingTipTailPolygonMarginRight">0,0,-1,0</Thickness>
    <GridLength x:Key="TeachingTipTailShortSideLength">8</GridLength>
    <GridLength x:Key="TeachingTipTailMargin">10</GridLength>
    <sys:Double x:Key="TeachingTipAlternateCloseButtonSize">40</sys:Double>
    <sys:Double x:Key="TeachingTipAlternateCloseButtonGlyphSize">16</sys:Double>
    <Thickness x:Key="TeachingTipContentMargin">12</Thickness>
    <sys:Double x:Key="TeachingTipTopHighlightHeight">1</sys:Double>
    <sys:Double x:Key="TeachingTipBorderThickness">1</sys:Double>
    <Thickness x:Key="TeachingTipTopHighlightOffsetForBorder">0,1,0,0</Thickness>
    <ui:CornerRadiusFilterConverter x:Key="TopCornerRadiusFilterConverter" Filter="Top" />
    <ui:CornerRadiusFilterConverter x:Key="BottomCornerRadiusFilterConverter" Filter="Bottom" />

    <Style x:Key="TeachingTipAlternateCloseButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource {x:Static SystemParameters.FocusVisualStyleKey}}" />
        <Setter Property="Width" Value="{StaticResource TeachingTipAlternateCloseButtonSize}" />
        <Setter Property="Height" Value="{StaticResource TeachingTipAlternateCloseButtonSize}" />
        <Setter Property="Background" Value="{DynamicResource TeachingTipAlternateCloseButtonBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TeachingTipAlternateCloseButtonForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TeachingTipAlternateCloseButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource TeachingTipAlternateCloseButtonBorderThickness}" />
        <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TeachingTipAlternateCloseButtonGlyphSize}" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Content" Value="&#xE711;" />
        <Setter Property="ui:FocusVisualHelper.UseSystemFocusVisuals" Value="{DynamicResource UseSystemFocusVisuals}" />
        <Setter Property="ui:FocusVisualHelper.FocusVisualMargin" Value="-3" />
        <Setter Property="Border.CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="ContentBorder"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        MinWidth="{TemplateBinding MinWidth}"
                        MinHeight="{TemplateBinding MinHeight}"
                        Padding="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalAlignment}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding Border.CornerRadius}">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource TeachingTipAlternateCloseButtonBackgroundPointerOver}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource TeachingTipAlternateCloseButtonBorderBrushPointerOver}" />
                            <Setter TargetName="ContentPresenter" Property="TextElement.Foreground" Value="{DynamicResource TeachingTipAlternateCloseButtonForegroundPointerOver}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource TeachingTipAlternateCloseButtonBackgroundDisabled}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource TeachingTipAlternateCloseButtonBorderBrushDisabled}" />
                            <Setter TargetName="ContentPresenter" Property="TextElement.Foreground" Value="{DynamicResource TeachingTipAlternateCloseButtonForegroundDisabled}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource TeachingTipAlternateCloseButtonBackgroundPressed}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource TeachingTipAlternateCloseButtonBorderBrushPressed}" />
                            <Setter TargetName="ContentPresenter" Property="TextElement.Foreground" Value="{DynamicResource TeachingTipAlternateCloseButtonForegroundPressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:TeachingTip">
        <Setter Property="Background" Value="{DynamicResource TeachingTipBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TeachingTipForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TeachingTipBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource TeachingTipContentBorderThicknessUntargeted}" />
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
        <Setter Property="ActionButtonStyle" Value="{DynamicResource DefaultButtonStyle}" />
        <Setter Property="CloseButtonStyle" Value="{DynamicResource DefaultButtonStyle}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TeachingTip">
                    <Grid x:Name="LayoutRoot">
                        <VisualStateManager.CustomVisualStateManager>
                            <ui:VisualStateManagerEx />
                        </VisualStateManager.CustomVisualStateManager>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="LightDismissStates">
                                <ui:VisualStateEx x:Name="LightDismiss">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="TailPolygon.Fill" Value="{DynamicResource TeachingTipTransientBackground}" />
                                        <ui:VisualStateSetter Target="ContentRootGrid.Background" Value="{DynamicResource TeachingTipTransientBackground}" />
                                        <ui:VisualStateSetter Target="MainContentPresenter.Background" Value="{DynamicResource TeachingTipTransientBackground}" />
                                        <ui:VisualStateSetter Target="HeroContentBorder.Background" Value="{DynamicResource TeachingTipTransientBackground}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="NormalDismiss">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="TailPolygon.Fill" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />
                                        <ui:VisualStateSetter Target="ContentRootGrid.Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />
                                        <ui:VisualStateSetter Target="MainContentPresenter.Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />
                                        <ui:VisualStateSetter Target="HeroContentBorder.Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="ButtonsStates">
                                <ui:VisualStateEx x:Name="NoButtonsVisible">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="CloseButton.Visibility" Value="Collapsed" />
                                        <ui:VisualStateSetter Target="ActionButton.Visibility" Value="Collapsed" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="ActionButtonVisible">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="CloseButton.Visibility" Value="Collapsed" />
                                        <ui:VisualStateSetter Target="ActionButton.Visibility" Value="Visible" />
                                        <ui:VisualStateSetter Target="ActionButton.(Grid.ColumnSpan)" Value="2" />
                                        <ui:VisualStateSetter Target="ActionButton.Margin" Value="{StaticResource TeachingTipButtonPanelMargin}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="CloseButtonVisible">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="CloseButton.Visibility" Value="Visible" />
                                        <ui:VisualStateSetter Target="CloseButton.Margin" Value="{StaticResource TeachingTipButtonPanelMargin}" />
                                        <ui:VisualStateSetter Target="CloseButton.(Grid.Column)" Value="0" />
                                        <ui:VisualStateSetter Target="CloseButton.(Grid.ColumnSpan)" Value="2" />
                                        <ui:VisualStateSetter Target="ActionButton.Visibility" Value="Collapsed" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="BothButtonsVisible">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="CloseButton.Visibility" Value="Visible" />
                                        <ui:VisualStateSetter Target="CloseButton.Margin" Value="{StaticResource TeachingTipRightButtonMargin}" />
                                        <ui:VisualStateSetter Target="ActionButton.Visibility" Value="Visible" />
                                        <ui:VisualStateSetter Target="ActionButton.(Grid.Column)" Value="0" />
                                        <ui:VisualStateSetter Target="ActionButton.Margin" Value="{StaticResource TeachingTipLeftButtonMargin}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="ContentStates">
                                <ui:VisualStateEx x:Name="Content">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="MainContentPresenter.Margin" Value="{StaticResource TeachingTipMainContentPresentMargin}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="NoContent">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="MainContentPresenter.Margin" Value="{StaticResource TeachingTipMainContentAbsentMargin}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="CloseButtonLocations">
                                <ui:VisualStateEx x:Name="HeaderCloseButton">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="TitlesStackPanel.Margin" Value="{StaticResource TeachingTipTitleStackPanelMarginWithHeaderCloseButton}" />
                                        <ui:VisualStateSetter Target="AlternateCloseButton.Visibility" Value="Visible" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="FooterCloseButton">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="TitlesStackPanel.Margin" Value="{StaticResource TeachingTipTitleStackPanelMarginWithFooterCloseButton}" />
                                        <ui:VisualStateSetter Target="AlternateCloseButton.Visibility" Value="Collapsed" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="IconStates">
                                <ui:VisualStateEx x:Name="Icon">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="IconPresenter.Visibility" Value="Visible" />
                                        <ui:VisualStateSetter Target="IconPresenter.Margin" Value="{StaticResource TeachingTipIconPresenterMarginWithIcon}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="NoIcon">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="IconPresenter.Visibility" Value="Collapsed" />
                                        <ui:VisualStateSetter Target="IconPresenter.Margin" Value="{StaticResource TeachingTipIconPresenterMarginWithoutIcon}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="HeroContentPlacementStates">
                                <ui:VisualStateEx x:Name="HeroContentTop">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="HeroContentBorder.(Grid.Row)" Value="0" />
                                        <ui:VisualStateSetter Target="HeroContentBorder.CornerRadius" Value="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TopCornerRadiusFilterConverter}}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="HeroContentBottom">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="HeroContentBorder.(Grid.Row)" Value="2" />
                                        <ui:VisualStateSetter Target="HeroContentBorder.CornerRadius" Value="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BottomCornerRadiusFilterConverter}}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="PlacementStates">
                                <ui:VisualStateEx x:Name="Top">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="TailPolygon.Visibility" Value="Visible" />
                                        <ui:VisualStateSetter Target="TailPolygon.Points" Value="0,0 10,10 20,0" />
                                        <ui:VisualStateSetter Target="TailPolygon.(Grid.Row)" Value="4" />
                                        <ui:VisualStateSetter Target="TailPolygon.(Grid.Column)" Value="2" />
                                        <ui:VisualStateSetter Target="TailPolygon.HorizontalAlignment" Value="Center" />
                                        <ui:VisualStateSetter Target="TailPolygon.VerticalAlignment" Value="Bottom" />
                                        <ui:VisualStateSetter Target="TailPolygon.Margin" Value="{StaticResource TeachingTipTailPolygonMarginTop}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="Bottom">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="TailPolygon.Visibility" Value="Visible" />
                                        <ui:VisualStateSetter Target="TailPolygon.Points" Value="0,10 10,0 20,10" />
                                        <ui:VisualStateSetter Target="TailPolygon.(Grid.Row)" Value="0" />
                                        <ui:VisualStateSetter Target="TailPolygon.(Grid.Column)" Value="2" />
                                        <ui:VisualStateSetter Target="TailPolygon.HorizontalAlignment" Value="Center" />
                                        <ui:VisualStateSetter Target="TailPolygon.VerticalAlignment" Value="Top" />
                                        <ui:VisualStateSetter Target="TailPolygon.Margin" Value="{StaticResource TeachingTipTailPolygonMarginBottom}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="Left">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="TailPolygon.Visibility" Value="Visible" />
                                        <ui:VisualStateSetter Target="TailPolygon.Points" Value="0,0 10,10 0,20" />
                                        <ui:VisualStateSetter Target="TailPolygon.(Grid.Row)" Value="2" />
                                        <ui:VisualStateSetter Target="TailPolygon.(Grid.Column)" Value="4" />
                                        <ui:VisualStateSetter Target="TailPolygon.HorizontalAlignment" Value="Right" />
                                        <ui:VisualStateSetter Target="TailPolygon.VerticalAlignment" Value="Center" />
                                        <ui:VisualStateSetter Target="TailPolygon.Margin" Value="{StaticResource TeachingTipTailPolygonMarginLeft}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="Right">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="TailPolygon.Visibility" Value="Visible" />
                                        <ui:VisualStateSetter Target="TailPolygon.Points" Value="10,0 0,10 10,20" />
                                        <ui:VisualStateSetter Target="TailPolygon.(Grid.Row)" Value="2" />
                                        <ui:VisualStateSetter Target="TailPolygon.(Grid.Column)" Value="0" />
                                        <ui:VisualStateSetter Target="TailPolygon.HorizontalAlignment" Value="Left" />
                                        <ui:VisualStateSetter Target="TailPolygon.VerticalAlignment" Value="Center" />
                                        <ui:VisualStateSetter Target="TailPolygon.Margin" Value="{StaticResource TeachingTipTailPolygonMarginRight}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="TopRight">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="TailPolygon.Visibility" Value="Visible" />
                                        <ui:VisualStateSetter Target="TailPolygon.Points" Value="0,0 10,10 20,0" />
                                        <ui:VisualStateSetter Target="TailPolygon.(Grid.Row)" Value="4" />
                                        <ui:VisualStateSetter Target="TailPolygon.(Grid.Column)" Value="2" />
                                        <ui:VisualStateSetter Target="TailPolygon.HorizontalAlignment" Value="Left" />
                                        <ui:VisualStateSetter Target="TailPolygon.VerticalAlignment" Value="Bottom" />
                                        <ui:VisualStateSetter Target="TailPolygon.Margin" Value="{StaticResource TeachingTipTailPolygonMarginTop}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="TopLeft">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="TailPolygon.Visibility" Value="Visible" />
                                        <ui:VisualStateSetter Target="TailPolygon.Points" Value="0,0 10,10 20,0" />
                                        <ui:VisualStateSetter Target="TailPolygon.(Grid.Row)" Value="4" />
                                        <ui:VisualStateSetter Target="TailPolygon.(Grid.Column)" Value="2" />
                                        <ui:VisualStateSetter Target="TailPolygon.HorizontalAlignment" Value="Right" />
                                        <ui:VisualStateSetter Target="TailPolygon.VerticalAlignment" Value="Bottom" />
                                        <ui:VisualStateSetter Target="TailPolygon.Margin" Value="{StaticResource TeachingTipTailPolygonMarginTop}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="BottomRight">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="TailPolygon.Visibility" Value="Visible" />
                                        <ui:VisualStateSetter Target="TailPolygon.Points" Value="0,10 10,0 20,10" />
                                        <ui:VisualStateSetter Target="TailPolygon.(Grid.Row)" Value="0" />
                                        <ui:VisualStateSetter Target="TailPolygon.(Grid.Column)" Value="2" />
                                        <ui:VisualStateSetter Target="TailPolygon.HorizontalAlignment" Value="Left" />
                                        <ui:VisualStateSetter Target="TailPolygon.VerticalAlignment" Value="Top" />
                                        <ui:VisualStateSetter Target="TailPolygon.Margin" Value="{StaticResource TeachingTipTailPolygonMarginBottom}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="BottomLeft">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="TailPolygon.Visibility" Value="Visible" />
                                        <ui:VisualStateSetter Target="TailPolygon.Points" Value="0,10 10,0 20,10" />
                                        <ui:VisualStateSetter Target="TailPolygon.(Grid.Row)" Value="0" />
                                        <ui:VisualStateSetter Target="TailPolygon.(Grid.Column)" Value="2" />
                                        <ui:VisualStateSetter Target="TailPolygon.HorizontalAlignment" Value="Right" />
                                        <ui:VisualStateSetter Target="TailPolygon.VerticalAlignment" Value="Top" />
                                        <ui:VisualStateSetter Target="TailPolygon.Margin" Value="{StaticResource TeachingTipTailPolygonMarginBottom}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="LeftTop">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="TailPolygon.Visibility" Value="Visible" />
                                        <ui:VisualStateSetter Target="TailPolygon.Points" Value="0,0 10,10 0,20" />
                                        <ui:VisualStateSetter Target="TailPolygon.(Grid.Row)" Value="2" />
                                        <ui:VisualStateSetter Target="TailPolygon.(Grid.Column)" Value="4" />
                                        <ui:VisualStateSetter Target="TailPolygon.HorizontalAlignment" Value="Right" />
                                        <ui:VisualStateSetter Target="TailPolygon.VerticalAlignment" Value="Bottom" />
                                        <ui:VisualStateSetter Target="TailPolygon.Margin" Value="{StaticResource TeachingTipTailPolygonMarginLeft}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="LeftBottom">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="TailPolygon.Visibility" Value="Visible" />
                                        <ui:VisualStateSetter Target="TailPolygon.Points" Value="0,0 10,10 0,20" />
                                        <ui:VisualStateSetter Target="TailPolygon.(Grid.Row)" Value="2" />
                                        <ui:VisualStateSetter Target="TailPolygon.(Grid.Column)" Value="4" />
                                        <ui:VisualStateSetter Target="TailPolygon.HorizontalAlignment" Value="Right" />
                                        <ui:VisualStateSetter Target="TailPolygon.VerticalAlignment" Value="Top" />
                                        <ui:VisualStateSetter Target="TailPolygon.Margin" Value="{StaticResource TeachingTipTailPolygonMarginLeft}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="RightTop">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="TailPolygon.Visibility" Value="Visible" />
                                        <ui:VisualStateSetter Target="TailPolygon.Points" Value="10,0 0,10 10,20" />
                                        <ui:VisualStateSetter Target="TailPolygon.(Grid.Row)" Value="2" />
                                        <ui:VisualStateSetter Target="TailPolygon.(Grid.Column)" Value="0" />
                                        <ui:VisualStateSetter Target="TailPolygon.HorizontalAlignment" Value="Left" />
                                        <ui:VisualStateSetter Target="TailPolygon.VerticalAlignment" Value="Bottom" />
                                        <ui:VisualStateSetter Target="TailPolygon.Margin" Value="{StaticResource TeachingTipTailPolygonMarginRight}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="RightBottom">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="TailPolygon.Visibility" Value="Visible" />
                                        <ui:VisualStateSetter Target="TailPolygon.Points" Value="10,0 0,10 10,20" />
                                        <ui:VisualStateSetter Target="TailPolygon.(Grid.Row)" Value="2" />
                                        <ui:VisualStateSetter Target="TailPolygon.(Grid.Column)" Value="0" />
                                        <ui:VisualStateSetter Target="TailPolygon.HorizontalAlignment" Value="Left" />
                                        <ui:VisualStateSetter Target="TailPolygon.VerticalAlignment" Value="Top" />
                                        <ui:VisualStateSetter Target="TailPolygon.Margin" Value="{StaticResource TeachingTipTailPolygonMarginRight}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="Center">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="TailPolygon.Visibility" Value="Visible" />
                                        <ui:VisualStateSetter Target="TailPolygon.Points" Value="0,0 10,10 20,0" />
                                        <ui:VisualStateSetter Target="TailPolygon.(Grid.Row)" Value="4" />
                                        <ui:VisualStateSetter Target="TailPolygon.(Grid.Column)" Value="2" />
                                        <ui:VisualStateSetter Target="TailPolygon.HorizontalAlignment" Value="Center" />
                                        <ui:VisualStateSetter Target="TailPolygon.VerticalAlignment" Value="Bottom" />
                                        <ui:VisualStateSetter Target="TailPolygon.Margin" Value="{StaticResource TeachingTipTailPolygonMarginTop}" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="Untargeted">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="TailPolygon.Visibility" Value="Collapsed" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="TitleBlockStates">
                                <ui:VisualStateEx x:Name="ShowTitleTextBlock">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="TitleTextBlock.Visibility" Value="Visible" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <VisualState x:Name="CollapseTitleTextBlock" />
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="SubtitleBlockStates">
                                <ui:VisualStateEx x:Name="ShowSubtitleTextBlock">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="SubtitleTextBlock.Visibility" Value="Visible" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <VisualState x:Name="CollapseSubtitleTextBlock" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Popup
                            x:Name="Popup"
                            AllowsTransparency="True"
                            PopupAnimation="None"
                            StaysOpen="True">
                            <Border
                                x:Name="Container"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                Visibility="Collapsed">
                                <Grid
                                    x:Name="TailOcclusionGrid"
                                    MinHeight="{StaticResource TeachingTipMinHeight}"
                                    MinWidth="{StaticResource TeachingTipMinWidth}"
                                    MaxHeight="{StaticResource TeachingTipMaxHeight}"
                                    MaxWidth="{StaticResource TeachingTipMaxWidth}">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="TailOcclusionScaleTransform" />
                                    </Grid.RenderTransform>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource TeachingTipTailShortSideLength}" />
                                        <ColumnDefinition Width="{StaticResource TeachingTipTailMargin}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{StaticResource TeachingTipTailMargin}" />
                                        <ColumnDefinition Width="{StaticResource TeachingTipTailShortSideLength}" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="{StaticResource TeachingTipTailShortSideLength}" />
                                        <RowDefinition Height="{StaticResource TeachingTipTailMargin}" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="{StaticResource TeachingTipTailMargin}" />
                                        <RowDefinition Height="{StaticResource TeachingTipTailShortSideLength}" />
                                    </Grid.RowDefinitions>

                                    <ui:ThemeShadowChrome
                                        x:Name="ContentRootGridShadowChrome"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Grid.RowSpan="3"
                                        Grid.ColumnSpan="3"
                                        Depth="32"
                                        IsShadowEnabled="{DynamicResource {x:Static SystemParameters.DropShadowKey}}"
                                        WindowedPopupInsetMode="Medium"
                                        CornerRadius="{Binding ElementName=ContentRootGrid, Path=CornerRadius}"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                        <Border
                                            x:Name="ContentRootGrid"
                                            AutomationProperties.AutomationId="ContentRootGrid"
                                            AutomationProperties.Name="{TemplateBinding Title}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Border
                                                    x:Name="HeroContentBorder"
                                                    Grid.Row="0"
                                                    Background="{TemplateBinding Background}"
                                                    Visibility="Collapsed">
                                                    <ui:ContentPresenterEx Content="{TemplateBinding HeroContent}" />
                                                </Border>

                                                <Grid x:Name="NonHeroContentRootGrid" Grid.Row="1">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                        <StackPanel Margin="{StaticResource TeachingTipContentMargin}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <ui:ContentPresenterEx
                                                                    x:Name="IconPresenter"
                                                                    Grid.Column="0"
                                                                    Margin="{StaticResource TeachingTipIconPresenterMarginWithIcon}"
                                                                    Content="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.IconElement}"
                                                                    Foreground="{TemplateBinding Foreground}"
                                                                    Visibility="Collapsed" />
                                                                <StackPanel
                                                                    x:Name="TitlesStackPanel"
                                                                    Grid.Column="1"
                                                                    Margin="{StaticResource TeachingTipTitleStackPanelMarginWithHeaderCloseButton}">
                                                                    <TextBlock
                                                                        x:Name="TitleTextBlock"
                                                                        Text="{TemplateBinding Title}"
                                                                        TextWrapping="Wrap"
                                                                        Foreground="{DynamicResource TeachingTipTitleForegroundBrush}"
                                                                        FontFamily="{TemplateBinding FontFamily}"
                                                                        FontWeight="SemiBold"
                                                                        Visibility="Collapsed" />
                                                                    <TextBlock
                                                                        x:Name="SubtitleTextBlock"
                                                                        Text="{TemplateBinding Subtitle}"
                                                                        TextWrapping="Wrap"
                                                                        Foreground="{DynamicResource TeachingTipSubtitleForegroundBrush}"
                                                                        FontFamily="{TemplateBinding FontFamily}"
                                                                        Visibility="Collapsed" />
                                                                </StackPanel>
                                                            </Grid>

                                                            <ui:ContentPresenterEx
                                                                x:Name="MainContentPresenter"
                                                                Margin="{StaticResource TeachingTipMainContentPresentMargin}"
                                                                Background="{TemplateBinding Background}"
                                                                Content="{TemplateBinding Content}"
                                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                FontFamily="{TemplateBinding FontFamily}"
                                                                FontSize="{TemplateBinding FontSize}"
                                                                FontStretch="{TemplateBinding FontStretch}"
                                                                FontStyle="{TemplateBinding FontStyle}"
                                                                FontWeight="{TemplateBinding FontWeight}"
                                                                Foreground="{TemplateBinding Foreground}" />

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Button
                                                                    x:Name="ActionButton"
                                                                    HorizontalAlignment="Stretch"
                                                                    Style="{TemplateBinding ActionButtonStyle}"
                                                                    Content="{TemplateBinding ActionButtonContent}"
                                                                    Visibility="Collapsed" />
                                                                <Button
                                                                    x:Name="CloseButton"
                                                                    Grid.Column="1"
                                                                    HorizontalAlignment="Stretch"
                                                                    Style="{TemplateBinding CloseButtonStyle}"
                                                                    Content="{TemplateBinding CloseButtonContent}"
                                                                    Visibility="Collapsed" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </ScrollViewer>

                                                    <Button
                                                        x:Name="AlternateCloseButton"
                                                        Style="{StaticResource TeachingTipAlternateCloseButtonStyle}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </ui:ThemeShadowChrome>

                                    <Polygon
                                        x:Name="TailPolygon"
                                        Fill="{TemplateBinding Background}"
                                        Stroke="{TemplateBinding BorderBrush}"
                                        StrokeThickness="{StaticResource TeachingTipBorderThickness}"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
