<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:local="clr-namespace:ModernWpf.Controls">

    <Style x:Key="DefaultTwoPaneViewStyle" TargetType="local:TwoPaneView">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinWideModeWidth" Value="641" />
        <Setter Property="MinTallModeHeight" Value="641" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TwoPaneView">
                    <Grid
                        x:Name="RootGrid"
                        Background="{TemplateBinding Background}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="PART_ColumnLeft" Width="Auto" />
                            <ColumnDefinition x:Name="PART_ColumnMiddle" Width="0" />
                            <ColumnDefinition x:Name="PART_ColumnRight" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="PART_RowTop" Height="*" />
                            <RowDefinition x:Name="PART_RowMiddle" Height="0" />
                            <RowDefinition x:Name="PART_RowBottom" Height="0" />
                        </Grid.RowDefinitions>
                        <VisualStateManager.CustomVisualStateManager>
                            <ui:VisualStateManagerEx />
                        </VisualStateManager.CustomVisualStateManager>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ModeStates">
                                <VisualState x:Name="ViewMode_LeftRight" />
                                <ui:VisualStateEx x:Name="ViewMode_RightLeft">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="PART_Pane1ScrollViewer.(Grid.Column)" Value="2" />
                                        <ui:VisualStateSetter Target="PART_Pane2ScrollViewer.(Grid.Column)" Value="0" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="ViewMode_TopBottom">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="PART_Pane1ScrollViewer.(Grid.Column)" Value="0" />
                                        <ui:VisualStateSetter Target="PART_Pane1ScrollViewer.(Grid.Row)" Value="0" />
                                        <ui:VisualStateSetter Target="PART_Pane2ScrollViewer.(Grid.Column)" Value="0" />
                                        <ui:VisualStateSetter Target="PART_Pane2ScrollViewer.(Grid.Row)" Value="2" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="ViewMode_BottomTop">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="PART_Pane1ScrollViewer.(Grid.Column)" Value="0" />
                                        <ui:VisualStateSetter Target="PART_Pane1ScrollViewer.(Grid.Row)" Value="2" />
                                        <ui:VisualStateSetter Target="PART_Pane2ScrollViewer.(Grid.Column)" Value="0" />
                                        <ui:VisualStateSetter Target="PART_Pane2ScrollViewer.(Grid.Row)" Value="0" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="ViewMode_OneOnly">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="PART_Pane2ScrollViewer.Visibility" Value="Collapsed" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                                <ui:VisualStateEx x:Name="ViewMode_TwoOnly">
                                    <ui:VisualStateEx.Setters>
                                        <ui:VisualStateSetter Target="PART_Pane1ScrollViewer.Visibility" Value="Collapsed" />
                                        <ui:VisualStateSetter Target="PART_Pane2ScrollViewer.(Grid.Column)" Value="0" />
                                    </ui:VisualStateEx.Setters>
                                </ui:VisualStateEx>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <ScrollViewer
                            x:Name="PART_Pane1ScrollViewer"
                            Grid.Column="0"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Auto">
                            <ui:ContentPresenterEx Content="{TemplateBinding Pane1}" />
                        </ScrollViewer>
                        <ScrollViewer
                            x:Name="PART_Pane2ScrollViewer"
                            Grid.Column="2"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Auto">
                            <ui:ContentPresenterEx Content="{TemplateBinding Pane2}" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:TwoPaneView" BasedOn="{StaticResource DefaultTwoPaneViewStyle}" />
</ResourceDictionary>
