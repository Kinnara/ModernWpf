<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>$id$</id>
    <version>$version$</version>
    <title>$displayName$</title>
    <authors>$authors$</authors>
    <owners>$authors$</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">$license$</license>
    <projectUrl>$projectUrl$</projectUrl>
    <repository type="$repositoryType$" url="$repositoryUrl$" commit="$repositoryCommit$" />
    <readme>readme.md</readme>
    <icon>icon.png</icon>
    <description>Fluent styles and WinUI-inspired controls for WPF, supporting .NET Framework 4.6.2, .NET 8, and .NET 10.</description>
    <releaseNotes>https://github.com/Kinnara/ModernWpf/blob/v$version$/docs/release-notes-$version$.md</releaseNotes>
    <tags>$tags$</tags>
    <dependencies>
      <group targetFramework="net462">
        <dependency id="System.ValueTuple" version="$systemValueTupleVersion$" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Windows.SDK.Contracts" version="$windowsSdkContractsVersion$" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0-windows7.0" />
      <group targetFramework="net10.0-windows7.0" />
    </dependencies>
    <frameworkReferences>
      <group targetFramework="net8.0-windows7.0">
        <frameworkReference name="Microsoft.WindowsDesktop.App.WPF" />
      </group>
      <group targetFramework="net10.0-windows7.0">
        <frameworkReference name="Microsoft.WindowsDesktop.App.WPF" />
      </group>
    </frameworkReferences>
  </metadata>
  <files>
    <file src="bin\$configuration$\**\ModernWpf*.dll" target="lib" />
    <file src="bin\$configuration$\**\ModernWpf*.pdb" target="lib" />
    <file src="bin\$configuration$\**\ModernWpf*.xml" target="lib" />
    <file src="readme.md" target="" />
    <file src="icon.png" target="" />
  </files>
</package>
